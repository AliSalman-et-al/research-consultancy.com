---
import { Image } from 'astro:assets';
import BarFigure from '../components/figures/BarFigure.astro';
import Dumbbell from '../components/figures/Dumbbell.astro';
import ModelFigure from '../components/figures/ModelFigure.astro';
import Pathway from '../components/figures/Pathway.astro';
import StudyAnatomy from '../components/figures/StudyAnatomy.astro';
import StudyNeeds from '../components/figures/StudyNeeds.astro';
import Abbreviations from '../components/journal/Abbreviations.astro';
import ActionPanel from '../components/journal/ActionPanel.astro';
import ArticleEnd from '../components/journal/ArticleEnd.astro';
import ArticleHead from '../components/journal/ArticleHead.astro';
import Caption from '../components/journal/Caption.astro';
import Cite from '../components/journal/Cite.astro';
import JSection from '../components/journal/JSection.astro';
import MultiFigure from '../components/journal/MultiFigure.astro';
import NextSteps from '../components/journal/NextSteps.astro';
import WhatIsNew from '../components/journal/WhatIsNew.astro';
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/paths';
import { pick } from '../data/abbreviations';
import { leaders } from '../data/people';
import { events } from '../data/research';
import { accArticle, contact, nrmp } from '../data/site';
import { photo } from '../lib/photos';

const sections = [
	{ id: 'introduction', label: 'Introduction' },
	{ id: 'methods', label: 'Methods' },
	{ id: 'results', label: 'Results' },
	{ id: 'discussion', label: 'Discussion' },
	{ id: 'next-steps', label: 'Next steps' },
];

const abstract = [
	{
		label: 'Background',
		text: 'U.S. residency programs expect applicants to have done research, and international graduates who match have usually published more than those who do not. Few medical schools outside the United States teach research methods, and students who want to learn seldom find a mentor.',
	},
	{
		label: 'Methods',
		text: 'Research Consultancy (RC) teaches research in live online courses: Level 1, an introduction for beginners, followed by courses in meta-analysis and in 3 U.S. national databases. After each method course, students join a small project group, led by a near-peer mentor and supervised by physician-scientists at U.S. academic hospitals, and work on a study until it is submitted for publication.',
	},
	{
		label: 'Results',
		text: "By 2024, more than 3,500 students had trained with RC and published more than 600 papers. In 2025 alone, students published more than 150 papers and presented 40 abstracts at the American College of Cardiology Scientific Session. In RC's 12-month Match Mentorship program, 90% of students matched in 2025 and 80% in 2026.",
	},
	{
		label: 'Conclusions',
		text: 'Students without research experience can learn research methods and publish before they apply for residency when teaching is followed by supervised projects. Level 1 is the first step.',
	},
];

const keywords = [
	{ label: 'Level 1', href: '/courses/level-1' },
	{ label: 'meta-analysis', href: '/courses/meta-analysis' },
	{ label: 'CDC WONDER', href: '/courses/cdc-wonder' },
	{ label: 'National Inpatient Sample', href: '/courses/nis' },
	{ label: 'Nationwide Readmissions Database', href: '/courses/nrd' },
	{ label: 'Match Mentorship', href: '/match-mentorship' },
];

// NRMP Charting Outcomes, non-U.S. IMGs, 2026 Main Residency Match, Table 9: median publications
// by preferred specialty and Match status. The ten specialties with the most non-U.S. IMG applicants.
const pubsBySpecialty = [
	{ label: 'Internal Medicine', sub: '5,379 applicants', a: 3, b: 2 },
	{ label: 'Family Medicine', sub: '833', a: 2, b: 2 },
	{ label: 'Pediatrics', sub: '604', a: 2, b: 3 },
	{ label: 'Neurology', sub: '397', a: 5, b: 3 },
	{ label: 'General Surgery', sub: '332', a: 8, b: 5 },
	{ label: 'Psychiatry', sub: '297', a: 3, b: 2 },
	{ label: 'Pathology', sub: '284', a: 7, b: 4 },
	{ label: 'Anesthesiology', sub: '184', a: 4, b: 2 },
	{ label: 'Diagnostic Radiology', sub: '127', a: 6, b: 4 },
	{ label: 'Obstetrics and Gynecology', sub: '114', a: 3, b: 2 },
];

const menteeOutput = [
	{ label: 'Aimen Shafiq', sub: 'Level 1 in first year; now a cardiology postdoc, UMMC', value: 47 },
	{ label: 'Asad Cheema', sub: 'about a year after Level 1', value: 35 },
	{ label: 'Adeena Jamil', sub: 'Level 1 in second year; now a postdoc, Baylor Scott & White', value: 24 },
	{ label: 'Ezza Bashir', sub: 'submitted by the time of ERAS; matched in 2026', value: 10 },
];

const refs = [
	{ text: 'National Resident Matching Program. Charting Outcomes: characteristics of applicants who matched to their preferred specialty. Non-U.S. IMGs, 2026 Main Residency Match. July 2026.', href: nrmp },
	{ text: 'United States Medical Licensing Examination. USMLE Step 1 transition to pass/fail only score reporting. January 2022.', href: 'https://www.usmle.org/usmle-step-1-transition-passfail-only-score-reporting' },
	{ text: 'Khan MS. Fostering the next generation of physician-scientists in developing countries. American College of Cardiology, Fellows in Training Section. January 22, 2024.', href: accArticle },
	{ text: 'Research Consultancy. The year in review, 2025. December 2025.', href: 'https://www.facebook.com/researchconsultancyrc' },
	{ text: 'Research Consultancy. Match 2025 and Match 2026 results. March 2026.', href: 'https://www.facebook.com/researchconsultancyrc' },
];
---

<Layout accent="rust" runningHead="Your Name et al." description="Research Consultancy teaches medical students research in live online courses, then supervises their first studies until submission. From a first course to a first publication and the U.S. Match.">
	<ArticleHead
		type="Original Article"
		page="e001"
		dateline="Received the day you enroll; revised with your mentor; accepted when your paper is."
		title="From First Course to First Publication: A Mentored Research Training Model for International Medical Students"
		abstract={abstract}
		keywords={keywords}
		sections={sections}
	>
		<div slot="byline" class="mt-5">
			<p class="j-byline text-ink-secondary">
				<span class="relative inline-block font-semibold text-ink">
					<span class="marker absolute inset-x-[-4px] bottom-[0.06em] h-[0.45em] rounded-[2px] bg-orange/60"></span>
					<span class="relative">Your Name<sup>1</sup></span>
				</span>; M. Shahzeb Khan, MD, MS<sup>2</sup>; Kaneez Fatima, MD<sup>2</sup>; M. Shariq Usman, MD<sup>3</sup>; Tariq Jamal Siddiqi, MD<sup>2</sup>
			</p>
			<p class="j-affil mt-1"><sup>1</sup>Your medical school, anywhere in the world. <sup>2</sup>Baylor Scott &amp; White, Dallas, Texas. <sup>3</sup>UT Southwestern Medical Center, Dallas, Texas.</p>
		</div>
		<ActionPanel
			slot="aside"
			title="Start here"
			lead={{ label: 'Level 1, the first course', value: '$35' }}
			facts={[
				{ label: 'Length', value: '2 days, 6 hours each' },
				{ label: 'Where', value: 'Live on Zoom' },
				{ label: 'Before you join', value: 'No research experience needed' },
			]}
			primary={{ label: 'See Level 1 and enroll', href: withBase('/courses/level-1') }}
			secondary={{ label: 'Ask us on WhatsApp', href: contact.whatsapp.href }}
			note={`Applying for residency this cycle? <a href="${withBase('/match-mentorship')}" class="link font-medium">Match Mentorship</a>`}
		/>
		<Pathway slot="illustration" class="ring-1 ring-hairline" />
	</ArticleHead>

	<JSection title="Introduction" id="introduction" hideTitle>
		<div class="j-main j-prose">
			<p class="drop-cap">
				Research has become a routine part of the U.S. residency application. Since Step 1 became pass/fail in 2022, Step 2
				CK, clinical experience in the United States, letters of recommendation and research carry more of the
				application.<Cite n={2} /> The stakes are highest for international graduates. In the 2026 Match, 41.5% of non-U.S.
				international medical graduates (IMGs) matched in the specialty they ranked first.<Cite n={1} />
			</p>
			<p>
				Publications track with success in the Match. In 8 of the 10 specialties to which non-U.S. IMGs apply most often,
				applicants who matched reported more publications than applicants who did not (Figure 1). In Internal Medicine, the
				specialty with the most applicants, the median was 3 publications among matched applicants and 2 among unmatched
				applicants; in Neurology, 5 and 3; and in Pathology, 7 and 4.<Cite n={1} />
			</p>
			<p>
				To a student who has never done it, research can seem opaque. In practice, a clinical study follows a fixed
				sequence: a question about patients, data that can answer it, an analysis, an abstract presented at a scientific
				meeting, and a paper that other physicians review before a journal publishes it (Figure 2).
			</p>
			<p>
				Most international students never get started. Few medical schools outside the United States teach research
				methods, and students who want to learn seldom find a mentor.<Cite n={3} /> Research Consultancy (RC) was founded in
				2016 to teach those methods and to supervise students' first projects until they are submitted.
			</p>
			<p>
				Here we describe how RC teaches research to students with no prior experience, and we report the publications,
				presentations and Match results of its students from 2016 to 2026.
			</p>
		</div>
		<div class="j-margin space-y-6">
			<WhatIsNew
				columns={1}
				blocks={[
					{
						title: 'What is new?',
						items: [
							'RC teaches research methods online to medical students in any country and supervises their first projects until submission.',
							'Its methods, meta-analysis and U.S. database research, need no patients, laboratory or hospital access.',
							'Mentors are former RC students; faculty are physician-scientists at U.S. academic hospitals.',
						],
					},
					{
						title: 'What it means for you',
						items: [
							'You can start with no research experience.',
							'Your name appears on work you did, in journals residency programs recognize.',
							'You work with U.S. faculty who can write your letters of recommendation.',
						],
					},
				]}
			/>
			<Abbreviations items={pick('IMG', 'NRMP', 'USMLE', 'Step 2 CK', 'CDC WONDER', 'NIS', 'NRD', 'ICMJE')} />
		</div>

		<div class="j-span grid gap-8 lg:grid-cols-2">
			<Dumbbell
				label="Figure 1"
				title="Median publications of non-U.S. international medical graduates who did and did not match, by preferred specialty, 2026 Main Residency Match."
				rows={pubsBySpecialty}
				aName="Matched"
				bName="Did not match"
				max={10}
				ticks={[0, 2, 4, 6, 8, 10]}
				axis="Median publications"
			>
				The 10 specialties with the most non-U.S. IMG applicants are shown, with the number of applicants. Publication counts
				are self-reported, and matched applicants also had higher Step 2 CK scores, so research is one factor among
				several.<Cite n={1} /> IMG indicates international medical graduate; and Step 2 CK, United States Medical Licensing
				Examination Step 2 Clinical Knowledge.
			</Dumbbell>
			<StudyAnatomy label="Figure 2" />
		</div>
	</JSection>

	<JSection title="Methods" id="methods" newPage>
		<div class="j-main j-prose">
			<h3 class="j-subhead">Setting and Participants</h3>
			<p>
				RC is an online research school. Classes are taught live on Zoom, in the morning U.S. Central time, and are open to
				medical students in any year, graduates and practicing physicians. Most students enroll without having worked on a
				study.
			</p>
			<h3 class="j-subhead">Courses</h3>
			<p>
				Every student begins with Level 1, 2 days of teaching in study design, scientific writing and statistics with SPSS.
				Students then choose a method course. RC teaches 2 families of methods because both can be started from any country
				as soon as the course ends (Figure 3). A meta-analysis pools the results of trials that have already been
				published. Studies of U.S. national databases (CDC WONDER, the National Inpatient Sample and the Nationwide
				Readmissions Database) use de-identified records and are therefore usually exempt from ethics review.{' '}
				<a href={withBase('/courses')}>Compare the 5 courses</a>.
			</p>
		</div>
		<StudyNeeds class="j-margin" label="Figure 3" />

		<div class="j-main j-prose">
			<h3 class="j-subhead">Mentored Projects</h3>
			<p>
				When a method course ends, each student joins a project group of a few students. Faculty choose the research
				questions and check the methods, a near-peer mentor leads the group and reviews every draft, and the students
				perform the analysis and write the manuscript (Figure 4).<Cite n={3} /> Authorship follows ICMJE criteria, so each
				student is credited for the work they did.
			</p>
			<h3 class="j-subhead">Outcomes</h3>
			<p>
				We report papers published in PubMed-indexed journals, abstracts accepted at scientific meetings and residency
				matches among students in Match Mentorship. Data come from RC records and students' reports. There is no comparison
				group.
			</p>
		</div>
		<ModelFigure class="j-margin" label="Figure 4" />
	</JSection>

	<JSection title="Results" id="results" newPage>
		<div class="j-main j-prose">
			<h3 class="j-subhead">Students</h3>
			<p>
				More than 3,500 students trained with RC between 2016 and 2024; 70% were women and one-third came from rural
				areas.<Cite n={3} /> In 2025, RC taught 20 courses.<Cite n={4} />
			</p>
			<h3 class="j-subhead">Publications and Presentations</h3>
			<p>
				By 2024, students had published more than 600 papers.<Cite n={3} /> In 2025 alone they published more than 150, in
				journals including <em>The Lancet</em>, <em>JAMA</em>, <em>Circulation</em>, <em>Neurology</em> and <em>Blood</em>.<Cite n={4} /> Output increased with time in
				the program; Figure 5 shows 4 students who began with Level 1 and stayed. At the 2025 American College of Cardiology
				Scientific Session, students presented 40 abstracts, all of which were published in <em>JACC</em> (Figure 6).
			</p>
		</div>
		<BarFigure
			class="j-margin"
			label="Figure 5"
			title="Publications by 4 RC students after Level 1."
			rows={menteeOutput}
			ticks={[0, 10, 20, 30, 40, 50]}
			max={50}
			axis="Publications"
		>
			Counts are published papers, except for Ezza Bashir's, which were submitted by the time of the residency application.
			The 4 students were chosen to show what is possible and are not typical; most students publish fewer. ERAS indicates
			Electronic Residency Application Service; and UMMC, University of Mississippi Medical Center.
		</BarFigure>

		<MultiFigure
			class="j-span"
			label="Figure 6"
			title="RC students and faculty presenting at scientific meetings."
			panels={events.slice(0, 3).map((e) => ({ src: e.photo, alt: e.caption, caption: e.caption }))}
		/>

		<div class="j-main j-prose">
			<h3 class="j-subhead">The Match</h3>
			<p>
				Match Mentorship is RC's 12-month program for residency applicants. In 2025, 90% of participants matched; in 2026,
				80% matched, 16 students in total (Table 1).<Cite n={5} /> More than 20 other students obtained research positions
				at U.S. hospitals, a common step before applying.<Cite n={3} />
			</p>
			<p>
				Each student's program and comments are listed under <a href={withBase('/match-mentorship#results')}>Match
				Mentorship</a>; their papers, careers and awards are in the <a href={withBase('/results')}>Supplemental Material</a>.
			</p>
		</div>
		<figure class="j-margin">
			<Caption label="Table 1" title="Match rates of RC Match Mentorship participants and of all non-U.S. international medical graduates." class="j-caption-top" />
			<table class="j-table">
				<thead><tr><th scope="col">Group</th><th scope="col" class="text-right">Matched</th></tr></thead>
				<tbody>
					<tr><th scope="row" class="font-normal">RC Match Mentorship, 2025</th><td class="text-right font-bold text-navy">90%</td></tr>
					<tr><th scope="row" class="font-normal">RC Match Mentorship, 2026</th><td class="text-right font-bold text-navy">80%</td></tr>
					<tr><th scope="row" class="font-normal">All non-U.S. IMGs, 2026, in their preferred specialty</th><td class="text-right">41.5%</td></tr>
				</tbody>
			</table>
			<p class="j-tablenote">RC rates count any match; the national rate counts matches in the preferred specialty. RC participants chose to join, so the comparison is not controlled.<Cite n="1,5" /> IMG indicates international medical graduate.</p>
		</figure>
	</JSection>

	<JSection title="Discussion" id="discussion" newPage>
		<div class="j-main j-prose">
			<h3 class="j-subhead">Why the Model Works</h3>
			<p>
				Three features of the model account for most of these results. First, the methods suit a student outside the United
				States: they require no patients, laboratory or ethics committee. Second, supervision does not end with the course
				but continues until the manuscript is submitted. Third, supervisors have recent experience of the same work. Mentors
				completed the same courses a year or two earlier, and faculty publish in the journals to which students submit.
			</p>
			<h3 class="j-subhead">Faculty and Mentors</h3>
			<p>
				RC's 4 faculty have more than 900 publications between them. They supervise projects, conduct mock interviews and
				write letters for students whose work merits them. Twelve mentors and research analysts, with more than 250 papers
				between them, lead the project groups day to day.
			</p>
		</div>
		<aside class="j-margin j-box self-start p-5">
			<h3 class="j-box-title text-[15px]">Limitations</h3>
			<ul class="mt-3 space-y-2.5 text-[14.5px] leading-snug text-ink-secondary">
				<li class="flex gap-2.5"><span class="mt-[0.5em] size-1.5 shrink-0 bg-navy"></span>No program can guarantee publication or a match. Be wary of any that does.</li>
				<li class="flex gap-2.5"><span class="mt-[0.5em] size-1.5 shrink-0 bg-navy"></span>Authorship depends on each student's contribution to a project.</li>
				<li class="flex gap-2.5"><span class="mt-[0.5em] size-1.5 shrink-0 bg-navy"></span>The results describe students who chose RC and stayed. There is no control group.</li>
				<li class="flex gap-2.5"><span class="mt-[0.5em] size-1.5 shrink-0 bg-navy"></span>Match outcomes also depend on examination scores, clinical experience and interviews, which RC can support but not control.</li>
			</ul>
		</aside>

		<figure class="j-span">
			<ul class="grid grid-cols-2 gap-x-5 gap-y-6 md:grid-cols-4">
				{leaders.map((p) => (
					<li class="flex items-start gap-3.5">
						<Image src={photo(p.photo)} alt={`Portrait of ${p.name}`} widths={[160, 320]} sizes="5.5rem" class="aspect-[4/5] w-[5.5rem] shrink-0 object-cover object-top" />
						<div class="min-w-0">
							<p class="text-[14.5px] leading-tight font-semibold">{p.name}</p>
							<p class="mt-1 text-[12.5px] leading-snug text-ink-muted">{p.title}, {p.place}</p>
							<p class="mt-1.5 text-[12.5px] font-semibold text-navy tabular-nums">{p.publications} publications</p>
						</div>
					</li>
				))}
			</ul>
			<Caption label="Figure 7" title="RC faculty.">Publication counts as of September 2026. <a href={withBase('/mentors')} class="link font-normal">Meet the faculty, mentors and analysts</a>.</Caption>
		</figure>

		<div class="j-main j-prose">
			<h3 class="j-subhead">Conclusions</h3>
			<p>
				Students without research experience can learn to publish before they apply for residency, provided that teaching
				is followed by supervised work on real studies. For most students, the first step is Level 1.
			</p>
		</div>
	</JSection>

	<NextSteps />

	<ArticleEnd page="e001" refs={refs} supplement />
</Layout>

<style>
	/* Your name is highlighted on the byline once the page settles. */
	@media (prefers-reduced-motion: no-preference) {
		.marker {
			transform-origin: left;
			animation: mark 700ms cubic-bezier(0.3, 0.7, 0.2, 1) 1.2s both;
		}
		@keyframes mark {
			from {
				transform: scaleX(0);
			}
			to {
				transform: scaleX(1);
			}
		}
	}
</style>
