---
// The Results page is the homepage's Supplemental Material: the evidence behind its numbers,
// labelled Table S1 and Figure S1 onward as AHA journals label an online supplement.
import MatchMap from '../components/figures/MatchMap.astro';
import Swimmer from '../components/figures/Swimmer.astro';
import ArticleEnd from '../components/journal/ArticleEnd.astro';
import ArticleHead from '../components/journal/ArticleHead.astro';
import Caption from '../components/journal/Caption.astro';
import Cite from '../components/journal/Cite.astro';
import JSection from '../components/journal/JSection.astro';
import MultiFigure from '../components/journal/MultiFigure.astro';
import NextSteps from '../components/journal/NextSteps.astro';
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/paths';
import { awards, events, facultyPapers, menteePapers, paths } from '../data/research';
import { accArticle, social, stats } from '../data/site';

// Publication types, each with a figure-palette colour used consistently on this page.
const kindColor: Record<string, string> = {
	Letter: '#4c9be8',
	Review: '#1b8a8f',
	Editorial: '#7b4fa0',
	'CDC WONDER': '#c98a12',
	NRD: '#d9546e',
	'Meta-analysis': '#f67737',
};

const sections = [
	{ id: 'careers', label: 'Careers' },
	{ id: 'publications', label: 'Publications' },
	{ id: 'presentations', label: 'Presentations' },
	{ id: 'recognition', label: 'Recognition' },
];

const abstract = [
	{
		label: 'Contents',
		text: 'This supplement holds the evidence summarized on our home page: headline numbers (Table S1), where students went after RC (Figure S1), how four of them got there (Figure S2), twelve recent papers by students and four by faculty (Table S2), students presenting at meetings (Figure S3), and awards (Table S3). Every paper links to the journal.',
	},
];

const refs = [
	{ text: 'Khan MS. Fostering the next generation of physician-scientists in developing countries. American College of Cardiology, Fellows in Training Section. January 22, 2024.', href: accArticle },
	{ text: 'Research Consultancy. Student publications, awards and Match results, 2023-2026.', href: 'https://www.facebook.com/researchconsultancyrc' },
];
---

<Layout accent="purple" runningHead="Supplemental Material" title="Results" description="The evidence behind RC's numbers: where students went, twelve recent papers, students at scientific meetings, and awards.">
	<ArticleHead type="Supplemental Material" page="e009" title="Publications, Careers and Awards of RC Students, 2016–2026" abstract={abstract} sections={sections}>
		<p slot="byline" class="j-affil mt-4 text-[13.5px]">
			Supplement to <a href={withBase('/')} class="link font-medium">Outcomes of Online Research Training and Mentorship for Medical Students, 2016–2026</a>.
		</p>
		<figure slot="aside">
			<Caption label="Table S1" title="Summary of RC outcomes, 2016–2026." class="j-caption-top" />
			<table class="j-table">
				<tbody>
					{stats.map((g) => (
						<tr><th scope="row" class="font-normal">{g.label[0].toUpperCase() + g.label.slice(1)}</th><td class="text-right text-[15px] font-bold text-navy">{g.value}</td></tr>
					))}
					<tr><th scope="row" class="font-normal">Peer-reviewed papers by students in 2025</th><td class="text-right text-[15px] font-bold text-navy">150+</td></tr>
					<tr><th scope="row" class="font-normal">Abstracts at ACC.25, all published in JACC</th><td class="text-right text-[15px] font-bold text-navy">40</td></tr>
				</tbody>
			</table>
			<p class="j-tablenote">From RC's records and a 2024 American College of Cardiology article on RC.<Cite n="1,2" /></p>
		</figure>
	</ArticleHead>

	<JSection title="Careers" id="careers">
		<div class="j-main j-prose">
			<p class="drop-cap">
				Our students have matched in Internal Medicine, Neurology, Pediatrics, Family Medicine, Emergency Medicine and
				Psychiatry. Others took paid research jobs at U.S. hospitals, including Emory, Baylor Scott &amp; White, Houston
				Methodist and the University of Mississippi Medical Center (Figure S1).<Cite n={2} />
			</p>
			<p id="stories" class="scroll-mt-32">
				Figure S2 follows four of them from their first course. Two started as graduates and went straight for the Match or
				a research job. Two started in their first or second year of medical school and built up over four years. All four
				took a course, worked on real projects within months, and went on to mentor other students.<Cite n={2} />
			</p>
		</div>
		<MatchMap class="j-margin" label="Figure S1" />
		<Swimmer class="j-span" label="Figure S2" paths={paths} />
	</JSection>

	<JSection title="Publications" id="publications" newPage>
		<div class="j-main">
			<Caption as="p" label="Table S2" title="Twelve recent publications by RC students." class="j-caption-top" />
			<p class="text-[14.5px] leading-relaxed text-ink-secondary">
				Cited the way you will learn to cite them. Each title opens the paper. We post new ones on{' '}
				<a href={social.instagram} class="link font-normal" rel="noopener">Instagram</a> most weeks.
			</p>
			<ol class="mt-5 space-y-4 border-t border-hairline pt-4">
				{menteePapers.map((p, i) => (
					<li class="grid grid-cols-[2rem_1fr] gap-1">
						<span class="pt-0.5 text-[14px] text-ink-muted tabular-nums">{i + 1}.</span>
						<div>
							<p class="text-[15px] leading-snug text-ink-secondary">
								{p.authors.replace(/\.$/, '')}. <a href={p.href} class="text-ink underline decoration-orange/40 underline-offset-2 hover:decoration-orange" rel="noopener">{p.title}.</a> <i>{p.journal}</i>. {p.year}.
							</p>
							<p class="mt-1 flex flex-wrap items-center gap-2 text-[12.5px]">
								<span class="inline-flex items-center gap-1.5 font-semibold" style={`color:color-mix(in srgb, ${kindColor[p.kind] ?? '#02264d'} 75%, black)`}><span class="size-2" style={`background:${kindColor[p.kind] ?? '#02264d'}`}></span>{p.kind}</span>
								{p.note && <span class="text-ink-muted">{p.note}</span>}
							</p>
						</div>
					</li>
				))}
			</ol>
		</div>
		<aside class="j-margin space-y-6 self-start">
			<div>
				<h3 class="j-box-title text-[14px]">From the faculty</h3>
				<p class="note mt-1">Students often join faculty papers as co-authors.</p>
				<ol class="mt-3 space-y-3 border-t border-hairline pt-3">
					{facultyPapers.map((p, i) => (
						<li class="grid grid-cols-[1.25rem_1fr] gap-1 text-[13px] text-ink-muted">
							<span class="tabular-nums">{i + 1}.</span>
							<p class="text-[14px] leading-snug text-ink-secondary">
								{p.authors.replace(/\.$/, '')}. <a href={p.href} class="text-ink underline decoration-orange/40 underline-offset-2 hover:decoration-orange" rel="noopener">{p.title}.</a> <i>{p.journal}</i>. {p.year}.
							</p>
						</li>
					))}
				</ol>
			</div>
			<p class="note border-t border-hairline pt-3"><b>Also by students.</b> Correspondence in <i>The Lancet</i> and <i>The Lancet Psychiatry</i>, letters in <i>JACC</i> and <i>JAMA Cardiology</i>, and reviews in the <i>European Heart Journal</i>.</p>
		</aside>
	</JSection>

	<JSection title="Presentations" id="presentations" newPage>
		<div class="j-main j-prose">
			<p>
				Most projects reach a conference as an abstract before they reach a journal as a paper. Figure S3 shows more of our
				students and faculty at scientific meetings. Table S3 lists the awards those abstracts have won.
			</p>
		</div>
		<MultiFigure
			class="j-span"
			layout="grid"
			label="Figure S3"
			title="RC students and faculty presenting at scientific meetings."
			panels={events.slice(3).map((e) => ({ src: e.photo, alt: e.caption, caption: e.caption }))}
		/>
	</JSection>

	<JSection title="Recognition" id="recognition">
		<figure class="j-span">
			<Caption label="Table S3" title="Awards and recognition received by RC students and faculty." class="j-caption-top" />
			<div class="overflow-x-auto">
				<table class="j-table min-w-[34rem]">
					<thead><tr><th scope="col">Recognition</th><th scope="col">Detail</th></tr></thead>
					<tbody>
						{awards.map((a) => (
							<tr class="align-top"><th scope="row" class="font-semibold">{a.title}</th><td class="text-[14.5px]">{a.detail}</td></tr>
						))}
					</tbody>
				</table>
			</div>
		</figure>
	</JSection>

	<NextSteps />

	<ArticleEnd page="e009" refs={refs} />
</Layout>
