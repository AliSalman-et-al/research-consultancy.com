---
// The Results page is the homepage's Supplemental Material: the evidence behind its numbers,
// labelled Table S1 and Figure S1 onward as AHA journals label an online supplement.
import MatchMap from '../components/figures/MatchMap.astro';
import Swimmer from '../components/figures/Swimmer.astro';
import ArticleEnd from '../components/journal/ArticleEnd.astro';
import ArticleHead from '../components/journal/ArticleHead.astro';
import Caption from '../components/journal/Caption.astro';
import Cite from '../components/journal/Cite.astro';
import Expand from '../components/journal/Expand.astro';
import JSection from '../components/journal/JSection.astro';
import MatchTable from '../components/journal/MatchTable.astro';
import MultiFigure from '../components/journal/MultiFigure.astro';
import NextSteps from '../components/journal/NextSteps.astro';
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/paths';
import { awards, events, facultyPapers, menteePapers, paths } from '../data/research';
import { match2025, match2026 } from '../data/people';
import { accArticle, social, stats, testimonials } from '../data/site';

// Publication types, each with a figure-palette colour used consistently on this page.
const kindColor: Record<string, string> = {
	Letter: '#4c9be8',
	Review: '#1b8a8f',
	Editorial: '#7b4fa0',
	'CDC WONDER': '#c98a12',
	NRD: '#d9546e',
	'Meta-analysis': '#f67737',
};

const sections = [
	{ id: 'careers', label: 'Where Students Went' },
	{ id: 'words', label: 'In Their Words' },
	{ id: 'publications', label: 'Papers' },
	{ id: 'presentations', label: 'Meetings and Awards' },
];

const summary = [
	{ a: 'This page holds the evidence behind the numbers on our homepage. Every paper links to the journal, so you can check it.' },
	{ a: 'Students have matched in 6 specialties and taken research jobs at U.S. hospitals such as Emory and Houston Methodist.' },
	{ a: 'By 2024 they had published more than 600 papers and presented at the main U.S. cardiology meetings.' },
];

const shown = 5;

const refs = [
	{ text: 'Khan MS. Fostering the next generation of physician-scientists in developing countries. American College of Cardiology, Fellows in Training Section. January 22, 2024.', href: accArticle },
	{ text: 'Research Consultancy. Student publications, awards and Match results, 2023-2026.', href: 'https://www.facebook.com/researchconsultancyrc' },
];
---

<Layout accent="purple" runningHead="Supplemental Material" title="Student Results" description="The evidence behind RC's numbers: where students went, what they say, their papers, meetings and awards.">
	<ArticleHead type="Supplemental Material" page="e009" title="What Our Students Achieved: Papers, Presentations, Research Jobs and Matches" summary={summary} sections={sections}>
		<p slot="byline" class="j-affil mt-4 text-[13.5px]">
			Supplement to <a href={withBase('/')} class="link font-medium">From First Course to First Paper: How Research Consultancy Trains Medical Students</a>.
		</p>
		<figure slot="aside">
			<Caption label="Table S1" title="Summary of RC outcomes, 2016 to 2026." class="j-caption-top" />
			<table class="j-table">
				<tbody>
					{stats.map((g) => (
						<tr><th scope="row" class="font-normal">{g.label[0].toUpperCase() + g.label.slice(1)}</th><td class="text-right text-[15px] font-bold text-navy">{g.value}</td></tr>
					))}
					<tr><th scope="row" class="font-normal">Match Mentorship students who matched, 2026</th><td class="text-right text-[15px] font-bold text-navy">80%</td></tr>
					<tr><th scope="row" class="font-normal">Papers published by students, 2025</th><td class="text-right text-[15px] font-bold text-navy">150+</td></tr>
				</tbody>
			</table>
			<p class="j-tablenote">From RC's records and a 2024 American College of Cardiology article on RC.<Cite n="1,2" /></p>
		</figure>
	</ArticleHead>

	<JSection title="Where Students Went" label="Careers" id="careers">
		<div class="j-main j-prose">
			<p class="drop-cap">
				<strong>Students leave RC for residency and for research jobs in the United States.</strong> They have matched in Internal Medicine, Neurology, Pediatrics, Family Medicine, Emergency Medicine and
				Psychiatry. Others took paid research jobs at U.S. hospitals, including Emory, Baylor Scott &amp; White, Houston
				Methodist and the University of Mississippi Medical Center (Figure S1).<Cite n={2} />
			</p>
			<p id="stories" class="scroll-mt-32">
				Figure S2 follows four of them from their first course. Two started as graduates and went straight for the Match or
				a research job. Two started in their first or second year of medical school and built up over four years. All four
				took a course, worked on real projects within months, and went on to mentor other students.<Cite n={2} />
			</p>
		</div>
		<MatchMap class="j-margin" label="Figure S1" />
		<Swimmer class="j-span" label="Figure S2" paths={paths} />
	</JSection>

	<JSection title="In Their Words" label="Testimonials" id="words" newPage>
		<div class="j-main j-prose">
			<p><strong>Students describe what helped, in their own words.</strong> Table S2 lists Match Mentorship students who matched in 2025 and 2026, with their programs and comments. Course students follow.</p>
		</div>
		<div class="j-span">
			<MatchTable
				label="Table S2"
				title="Residency programs matched by Match Mentorship students in 2025 and 2026, with their comments."
				groups={[
					{ name: 'Match 2026, 2025-26 group', rows: match2026 },
					{ name: 'Match 2025, selected students from the 2024-25 group', rows: match2025 },
				]}
				footnote="Of the 2025-26 group, 80% matched; of the 2024-25 group, 90%. Schools and quotes as given by students."
				shown={6}
			/>
		</div>
		<ul class="j-span grid gap-x-10 gap-y-8 md:grid-cols-2 lg:grid-cols-3">
			{testimonials.map((t) => (
				<li class="flex flex-col">
					<blockquote class="j-quote">"{t.quote}"</blockquote>
					<p class="mt-auto pt-3 text-[13px]"><span class="font-semibold">{t.name}</span><span class="text-ink-muted">, {t.role}</span></p>
				</li>
			))}
		</ul>
	</JSection>

	<JSection title="Papers" label="Publications" id="publications" newPage>
		<div class="j-main">
			<Caption as="p" label="Table S3" title="Twelve recent publications by RC students." class="j-caption-top" />
			<p class="text-[14.5px] leading-relaxed text-ink-secondary">
				<strong class="font-semibold text-ink">Students publish in journals residency programs know.</strong> Cited the way you will learn to cite them. Each title opens the paper. We post new ones on{' '}
				<a href={social.instagram} class="link font-normal" rel="noopener">Instagram</a> most weeks.
			</p>
			<ol class="mt-5 space-y-4 border-t border-hairline pt-4">
				{menteePapers.slice(0, shown).map((p, i) => (
					<li class="grid grid-cols-[2rem_1fr] gap-1">
						<span class="pt-0.5 text-[14px] text-ink-muted tabular-nums">{i + 1}.</span>
						<div>
							<p class="text-[15px] leading-snug text-ink-secondary">
								{p.authors.replace(/\.$/, '')}. <a href={p.href} class="text-ink underline decoration-orange/40 underline-offset-2 hover:decoration-orange" rel="noopener">{p.title}.</a> <i>{p.journal}</i>. {p.year}.
							</p>
							<p class="mt-1 flex flex-wrap items-center gap-2 text-[12.5px]">
								<span class="inline-flex items-center gap-1.5 font-semibold" style={`color:color-mix(in srgb, ${kindColor[p.kind] ?? '#02264d'} 75%, black)`}><span class="size-2" style={`background:${kindColor[p.kind] ?? '#02264d'}`}></span>{p.kind}</span>
								{p.note && <span class="text-ink-muted">{p.note}</span>}
							</p>
						</div>
					</li>
				))}
			</ol>
			<Expand label={`Show all ${menteePapers.length} papers`} class="mt-5">
				<ol class="space-y-4" start={shown + 1}>
					{menteePapers.slice(shown).map((p, i) => (
						<li class="grid grid-cols-[2rem_1fr] gap-1">
						<span class="pt-0.5 text-[14px] text-ink-muted tabular-nums">{i + shown + 1}.</span>
						<div>
							<p class="text-[15px] leading-snug text-ink-secondary">
								{p.authors.replace(/\.$/, '')}. <a href={p.href} class="text-ink underline decoration-orange/40 underline-offset-2 hover:decoration-orange" rel="noopener">{p.title}.</a> <i>{p.journal}</i>. {p.year}.
							</p>
							<p class="mt-1 flex flex-wrap items-center gap-2 text-[12.5px]">
								<span class="inline-flex items-center gap-1.5 font-semibold" style={`color:color-mix(in srgb, ${kindColor[p.kind] ?? '#02264d'} 75%, black)`}><span class="size-2" style={`background:${kindColor[p.kind] ?? '#02264d'}`}></span>{p.kind}</span>
								{p.note && <span class="text-ink-muted">{p.note}</span>}
							</p>
						</div>
					</li>
					))}
				</ol>
			</Expand>
		</div>
		<aside class="j-margin space-y-6 self-start">
			<div>
				<h3 class="j-box-title text-[14px]">From the faculty</h3>
				<p class="note mt-1">Students often join faculty papers as co-authors.</p>
				<ol class="mt-3 space-y-3 border-t border-hairline pt-3">
					{facultyPapers.map((p, i) => (
						<li class="grid grid-cols-[1.25rem_1fr] gap-1 text-[13px] text-ink-muted">
							<span class="tabular-nums">{i + 1}.</span>
							<p class="text-[14px] leading-snug text-ink-secondary">
								{p.authors.replace(/\.$/, '')}. <a href={p.href} class="text-ink underline decoration-orange/40 underline-offset-2 hover:decoration-orange" rel="noopener">{p.title}.</a> <i>{p.journal}</i>. {p.year}.
							</p>
						</li>
					))}
				</ol>
			</div>
			<p class="note border-t border-hairline pt-3"><b>Also by students.</b> Correspondence in <i>The Lancet</i> and <i>The Lancet Psychiatry</i>, letters in <i>JACC</i> and <i>JAMA Cardiology</i>, and reviews in the <i>European Heart Journal</i>.</p>
		</aside>
	</JSection>

	<JSection title="Meetings and Awards" label="Presentations" id="presentations" newPage>
		<div class="j-main j-prose">
			<p>
				Most projects reach a conference as an abstract before they reach a journal as a paper. Figure S3 shows more of our
				students and faculty at scientific meetings. Table S4 lists the awards those abstracts have won.
			</p>
		</div>
		<MultiFigure
			class="j-span"
			layout="grid"
			label="Figure S3"
			title="RC students and faculty presenting at scientific meetings."
			panels={events.map((e) => ({ src: e.photo, alt: e.caption, caption: e.caption, position: e.position }))}
		/>
		<figure class="j-span">
			<Caption label="Table S4" title="Awards and recognition received by RC students and faculty." class="j-caption-top" />
			<div class="overflow-x-auto">
				<table class="j-table sm:min-w-[34rem]">
					<thead><tr><th scope="col">Recognition</th><th scope="col">Detail</th></tr></thead>
					<tbody>
						{awards.map((a) => (
							<tr class="align-top"><th scope="row" class="font-semibold">{a.title}</th><td class="text-[14.5px]">{a.detail}</td></tr>
						))}
					</tbody>
				</table>
			</div>
		</figure>
	</JSection>

	<NextSteps />

	<ArticleEnd page="e009" refs={refs} />
</Layout>
