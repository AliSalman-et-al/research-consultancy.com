---
// Contact, set as Correspondence. The letter composer turns a few answers into a message the
// visitor sends on WhatsApp or by email. The site stores and sends nothing itself.
import ActionPanel from '../components/journal/ActionPanel.astro';
import ArticleEnd from '../components/journal/ArticleEnd.astro';
import ArticleHead from '../components/journal/ArticleHead.astro';
import JSection from '../components/journal/JSection.astro';
import FaqList from '../components/site/FaqList.astro';
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/paths';
import { contact, faqs, social } from '../data/site';

const channels = [
	{
		title: 'Courses and general questions',
		color: '#1b8a8f',
		lines: [
			{ label: 'WhatsApp, any time', value: contact.whatsapp.label, href: contact.whatsapp.href },
			{ label: 'Email', value: contact.email, href: `mailto:${contact.email}` },
		],
	},
	{
		title: 'Match, Fellowship and Green Card mentorship',
		color: '#f67737',
		lines: [
			{ label: 'WhatsApp or text', value: contact.matchWhatsapp.label, href: contact.matchWhatsapp.href },
			{ label: 'Email your CV', value: contact.email, href: `mailto:${contact.email}?subject=Mentorship%20application` },
		],
	},
];

const register = ['The course you want to join', 'Your full name', 'Your medical school', 'Your year of graduation, or your current role'];

const stages = ['a medical student in years 1 or 2', 'a medical student in year 3 or later', 'a medical graduate', 'a practicing doctor'];
const timing = ['this cycle', 'next cycle', 'in two years or more', 'when I am ready; I am not sure yet'];

const sections = [
	{ id: 'letter', label: 'Write Your Letter' },
	{ id: 'channels', label: 'Who to Contact' },
	{ id: 'register', label: 'Registering Without Paying Online' },
];
---

<Layout runningHead="Correspondence" title="Contact" description="Message Research Consultancy on WhatsApp or by email to register for a course or ask about Match Mentorship." cta={{ label: 'Message us on WhatsApp', href: contact.whatsapp.href }}>
	<ArticleHead
		type="Correspondence"
		page="e012"
		title="Contact Us: The Fastest Ways to Reach the RC Team"
		summary={[
			{ q: 'Fastest reply?', a: 'WhatsApp, on the number beside this summary. Email works too.' },
			{ q: 'Not sure what to ask?', a: 'Fill in the letter below. It writes the message for you, and you send it from your own WhatsApp or email.' },
			{ q: 'Applying for residency?', a: `Message the Match Mentorship team on ${contact.matchWhatsapp.label}.` },
		]}
		sections={sections}
	>
		<ActionPanel
			slot="aside"
			title="Fastest reply"
			lead={{ label: 'WhatsApp', value: contact.whatsapp.label }}
			primary={{ label: 'Message us on WhatsApp', href: contact.whatsapp.href }}
			secondary={{ label: 'Email us', href: `mailto:${contact.email}` }}
		/>
	</ArticleHead>

	<JSection title="Write Your Letter" label="Correspondence" id="letter">
		<form class="j-main grid gap-4 sm:grid-cols-2" id="composer" aria-describedby="composer-note">
			<label class="grid gap-1.5 text-[14px] font-semibold">
				Your name
				<input name="name" autocomplete="name" class="field" placeholder="Ayesha Khan" />
			</label>
			<label class="grid gap-1.5 text-[14px] font-semibold">
				Where you are in training
				<select name="stage" class="field">
					{stages.map((s) => { const l = s.replace(/^an? /, ''); return <option value={s}>{l[0].toUpperCase() + l.slice(1)}</option>; })}
				</select>
			</label>
			<label class="grid gap-1.5 text-[14px] font-semibold">
				Specialty you want
				<input name="specialty" class="field" placeholder="Internal Medicine" />
			</label>
			<label class="grid gap-1.5 text-[14px] font-semibold">
				When you plan to apply
				<select name="timing" class="field">
					{timing.map((t) => <option value={t}>{t[0].toUpperCase() + t.slice(1)}</option>)}
				</select>
			</label>
			<label class="grid gap-1.5 text-[14px] font-semibold sm:col-span-2">
				Your question <span class="font-normal text-ink-muted">(optional)</span>
				<textarea name="question" rows="3" class="field" placeholder="Which course should I start with?"></textarea>
			</label>
			<div class="flex flex-wrap items-center gap-3 sm:col-span-2">
				<a id="send-wa" href={contact.whatsapp.href} class="btn-primary" rel="noopener">Send on WhatsApp</a>
				<a id="send-mail" href={`mailto:${contact.email}`} class="btn-secondary">Send by email</a>
			</div>
			<p id="composer-note" class="note sm:col-span-2">Your message opens in WhatsApp or your email app for you to check and send. This page keeps nothing.</p>
		</form>
		<figure class="j-margin self-start border border-hairline bg-[#fbfaf7] p-5">
			<p class="text-[12px] font-bold tracking-[0.05em] text-navy uppercase">Your letter</p>
			<p id="letter-preview" class="mt-3 text-[15px] leading-relaxed text-ink" aria-live="polite"></p>
		</figure>
	</JSection>

	<JSection title="Who to Contact" label="Corresponding Authors" id="channels" newPage>
		<div class="j-main grid gap-4">
			{channels.map((c) => (
				<div class="border-t-[3px] bg-canvas-soft p-5" style={`border-color:${c.color}`}>
					<h3 class="font-semibold">{c.title}</h3>
					<dl class="mt-3 grid gap-3 sm:grid-cols-2">
						{c.lines.map((l) => (
							<div>
								<dt class="text-[12.5px] text-ink-muted">{l.label}</dt>
								<dd><a href={l.href} class="link text-[15px] font-normal [overflow-wrap:anywhere]" rel="noopener">{l.value}</a></dd>
							</div>
						))}
					</dl>
				</div>
			))}
		</div>
		<aside class="j-margin self-start space-y-3">
			<p class="note"><b>Class dates.</b> Dates, new papers and free webinars go out first on <a href={social.instagram} class="underline decoration-orange underline-offset-2" rel="noopener">Instagram</a>, <a href={social.linkedin} class="underline decoration-orange underline-offset-2" rel="noopener">LinkedIn</a> and <a href={social.facebook} class="underline decoration-orange underline-offset-2" rel="noopener">Facebook</a>.</p>
			<p class="note"><b>Joining the team.</b> Ambassador and mentor applications are on the <a href={withBase('/mentors#join')} class="underline decoration-orange underline-offset-2">Mentors</a> page.</p>
		</aside>
	</JSection>

	<JSection title="Registering Without Paying Online" label="Methods" id="register">
		<div class="j-main j-prose">
			<p>Each course page has a Register button while its class is open. If you cannot pay online, email us:</p>
			<ol class="list-none space-y-2 pl-0">
				{register.map((item, i) => (
					<li class="flex gap-3"><span class="font-bold text-label tabular-nums">{i + 1}.</span>{item}</li>
				))}
			</ol>
			<p>We confirm your seat and send the Zoom link before the first class.</p>
		</div>
		<div class="j-margin">
			<h3 class="j-box-title text-[14px]">Before you write</h3>
			<div class="mt-2"><FaqList items={faqs} /></div>
		</div>
	</JSection>

	<ArticleEnd page="e012" />
</Layout>

<script define:vars={{ wa: contact.whatsapp.href, email: contact.email }}>
	const form = document.getElementById('composer');
	const preview = document.getElementById('letter-preview');
	const sendWa = document.getElementById('send-wa');
	const sendMail = document.getElementById('send-mail');

	function letter() {
		const f = new FormData(form);
		const name = String(f.get('name') || '').trim();
		const specialty = String(f.get('specialty') || '').trim();
		const question = String(f.get('question') || '').trim();
		const lines = [
			'To the Editors:',
			`I am ${name || '[your name]'}, ${f.get('stage')}. I am interested in ${specialty || '[a specialty]'} and plan to apply ${f.get('timing')}.`,
		];
		if (question) lines.push(question);
		lines.push('Where should I start?');
		return lines.join('\n\n');
	}

	function update() {
		const text = letter();
		preview.textContent = text;
		preview.innerHTML = preview.innerHTML.replace(/\n\n/g, '<br><br>');
		sendWa.href = `${wa}?text=${encodeURIComponent(text)}`;
		sendMail.href = `mailto:${email}?subject=${encodeURIComponent('A question for Research Consultancy')}&body=${encodeURIComponent(text)}`;
	}

	form.addEventListener('input', update);
	form.addEventListener('submit', (e) => e.preventDefault());
	update();
</script>
