---
import { Image } from 'astro:assets';
import MatchYear from '../components/figures/MatchYear.astro';
import ActionPanel from '../components/journal/ActionPanel.astro';
import ArticleEnd from '../components/journal/ArticleEnd.astro';
import ArticleHead from '../components/journal/ArticleHead.astro';
import Caption from '../components/journal/Caption.astro';
import Cite from '../components/journal/Cite.astro';
import JSection from '../components/journal/JSection.astro';
import NextSteps from '../components/journal/NextSteps.astro';
import Registration from '../components/journal/Registration.astro';
import FaqList from '../components/site/FaqList.astro';
import Layout from '../layouts/Layout.astro';
import { leaders } from '../data/people';
import { withBase } from '../lib/paths';
import { contact, nrmp } from '../data/site';
import { photo } from '../lib/photos';

const included = [
	{ title: 'Research papers', body: 'You join several projects in the specialty you are applying to. The aim is at least two papers submitted or published by September, when programs start reading applications.', target: '2 or more papers' },
	{ title: 'A conference abstract', body: 'At least one abstract presented at an international meeting.', target: '1 or more' },
	{ title: 'Every RC course', body: 'Level 1, Meta-Analysis, CDC WONDER, NIS and NRD, as often as you like.', target: 'All 5' },
	{ title: 'CV and personal statement', body: 'Line-by-line edits from mentors who have been through the Match.', target: '' },
	{ title: 'Mock interviews', body: 'One-to-one practice interviews with a senior mentor, with feedback on every answer.', target: '' },
	{ title: 'Letters of recommendation', body: 'U.S. faculty write personalized letters for students whose work on a project earns one.', target: 'When earned' },
	{ title: 'A mentor group', body: 'A WhatsApp group with RC faculty and U.S. physicians, for questions about research, programs, signals and your rank list.', target: 'All year' },
];

const steps = [
	{ title: 'Send us your CV', body: `Email it to ${contact.email}, or send it on WhatsApp to ${contact.matchWhatsapp.label}.` },
	{ title: 'Talk to a mentor', body: 'A short call about your specialty, your scores, your timeline and what your application is missing.' },
	{ title: 'Take your place', body: 'If there is a place for you, we send the payment link.' },
];

const faqs = [
	{ q: 'Which specialties have students matched in?', a: 'Internal Medicine, Neurology, Pediatrics, Family Medicine, Emergency Medicine and Psychiatry.' },
	{ q: "I've never done research. Can I still join?", a: 'Yes. Many students learn during the year, starting with Level 1, which is included.' },
	{ q: 'Can you promise a paper or a match?', a: 'No, and be wary of anyone who does. You join real projects, and authorship depends on what you contribute.' },
];

// Three quotes, chosen for being short and specific. Every student's words are on Student Results.
const quotes = [
	{ name: 'Osman Wafai', program: 'HCA Centerpoint, Kansas City', quote: 'What helped most by far was the mock interview, which provided invaluable insight and feedback.' },
	{ name: 'Qais Bin Abdul Ghaffar', program: 'West Virginia University / Camden Clark Medical Center', quote: 'They allowed me to bring in the Program Director from the institution where I ultimately matched as a senior author.' },
	{ name: 'Ezza Bashir', program: "St. Luke's Hospital, St. Louis", quote: 'This was my second match cycle. As someone who was extremely scared of research, I had 10 papers submitted by the time I submitted the ERAS application.' },
];

const summary = [
	{ q: 'What is it?', a: "A 12-month program for students applying to U.S. residency, run by RC's 4 faculty. You join research projects in your specialty, and mentors edit your application and practice interviews with you." },
	{ q: 'Who is it for?', a: 'Final-year students and graduates applying in the 2026-27 Match. No research experience needed; every RC course is included.' },
	{ q: 'Does it work?', a: 'Of the 2025 group, 90% matched. Of the 2026 group, 80% matched, 16 students in all, two of them at Yale programs.' },
];

const sections = [
	{ id: 'introduction', label: 'Why Papers Are Not Enough' },
	{ id: 'methods', label: 'What You Get' },
	{ id: 'results', label: 'Where Students Matched' },
	{ id: 'apply', label: 'How to Apply' },
	{ id: 'questions', label: 'Questions' },
];

const refs = [
	{ text: 'National Resident Matching Program. Charting Outcomes: characteristics of applicants who matched to their preferred specialty. Non-U.S. IMGs, 2026 Main Residency Match. July 2026.', href: nrmp },
	{ text: 'Research Consultancy. Match 2025 and Match 2026 results and student stories. 2025-2026.', href: 'https://www.facebook.com/researchconsultancyrc' },
];
---

<Layout accent="red" runningHead="Match Mentorship" title="Match Mentorship" description="Twelve months of research, application editing and interview practice for the 2026-27 U.S. Match, run by RC's faculty. 20 places." register="match-mentorship">
	<ArticleHead
		type="Special Report"
		page="e008"
		title="Match Mentorship: Twelve Months of Research and Application Help Before the Match"
		summary={summary}
		sections={sections}
	>
		<p slot="byline" class="j-affil mt-4 text-[13.5px]">Run by M. Shahzeb Khan, MD, MS; Kaneez Fatima, MD; M. Shariq Usman, MD; and Tariq Jamal Siddiqi, MD.</p>
		<ActionPanel
			slot="aside"
			title="Applications for 2026-27"
			lead={{ label: 'Places', value: '20' }}
			facts={[
				{ label: 'Length', value: '12 months' },
				{ label: 'Includes', value: 'Every RC course' },
				{ label: 'To apply', value: 'Send your CV' },
			]}
			secondary={{ label: 'Ask a mentor on WhatsApp', href: contact.matchWhatsapp.href }}
		>
			<Registration slug="match-mentorship" />
		</ActionPanel>
	</ArticleHead>

	<JSection title="Why Papers Are Not Enough" label="Introduction" id="introduction">
		<div class="j-main j-prose">
			<p class="drop-cap">
				The Match is hard for international graduates. In 2026, 41.5% of graduates of schools outside the United States
				matched in the specialty they ranked first. In most specialties, the ones who matched had published more than the ones who did not.<Cite n={1} />
			</p>
			<p>
				Papers are only part of it. A program also reads your letters, your personal statement and how you interview, and
				all of it has to be ready when applications open in September. Match Mentorship plans the year backward from that
				date and gives each part to someone who has done it. Our four faculty run it themselves.
			</p>
		</div>
	</JSection>

	<JSection title="What You Get" label="Methods" id="methods" newPage>
		<div class="j-main j-prose">
			<p>
				Table 1 lists every part of the program. The research is organized so that papers are submitted before programs
				read applications, and the letters come from faculty who have seen your work.
			</p>
		</div>
		<ul class="j-margin self-start divide-y divide-hairline border-y border-hairline">
			{leaders.map((p) => (
				<li class="flex items-center gap-3 py-2.5">
					<Image src={photo(p.photo)} alt="" width={56} height={56} class="size-14 shrink-0 rounded-full object-cover object-top" />
					<div class="min-w-0">
						<p class="text-[15px] font-semibold">{p.name}</p>
						<p class="text-[12.5px] leading-snug text-ink-muted">{p.title}, {p.place}</p>
					</div>
					<span class="ml-auto text-[12px] font-semibold whitespace-nowrap text-navy tabular-nums">{p.publications} papers</span>
				</li>
			))}
		</ul>

		<figure class="j-span">
			<Caption label="Table 1" title="Components of Match Mentorship, 2026-27." class="j-caption-top" />
			<div class="overflow-x-auto">
				<table class="j-table sm:min-w-[36rem]">
					<thead><tr><th scope="col">Component</th><th scope="col">What you get</th><th scope="col" class="hidden sm:table-cell">Target</th></tr></thead>
					<tbody>
						{included.map((item) => (
							<tr class="align-top">
								<th scope="row" class="font-semibold">{item.title}{item.target && <span class="mt-1 block text-[12.5px] font-normal text-ink-muted sm:hidden">{item.target}</span>}</th>
								<td class="text-[14.5px]">{item.body}</td>
								<td class="hidden whitespace-nowrap sm:table-cell">{item.target}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<p class="j-tablenote">Authorship depends on each student's contribution. RC does not guarantee publications.</p>
		</figure>

		<div class="j-main j-prose">
			<h3 class="j-subhead">Timeline</h3>
			<p>
				Research comes first, so your papers are submitted before programs start reading applications. Editing, interviews
				and the rank list follow the Match calendar (Figure 1).
			</p>
		</div>
		<MatchYear class="j-span" label="Figure 1" />
	</JSection>

	<JSection title="Where Students Matched" label="Results" id="results" newPage>
		<div class="j-main j-prose">
			<p>
				Of the 2025 group, 90% matched. Of the 2026 group, 80% matched: 16 students, two of them at Yale programs. One had
				gone unmatched the year before. One graduated in 2007.<Cite n={2} />
			</p>
			<p>
				These are the students who chose to join, and many had strong scores, so the rates are not a controlled comparison.{' '}
				<a href={withBase('/results#words')}>See every student's program and comments</a>.
			</p>
		</div>
		<ul class="j-span grid gap-x-10 gap-y-8 md:grid-cols-3">
			{quotes.map((q) => (
				<li class="flex flex-col">
					<blockquote class="j-quote">"{q.quote}"</blockquote>
					<p class="mt-auto pt-3 text-[13px]"><span class="font-semibold">{q.name}</span><span class="text-ink-muted">, matched at {q.program}</span></p>
				</li>
			))}
		</ul>
	</JSection>

	<JSection title="How to Apply" label="Submission Guidelines" id="apply" newPage>
		<ol class="j-main space-y-5">
			{steps.map((s, i) => (
				<li class="grid grid-cols-[2.25rem_1fr] gap-3">
					<span class:list={['grid size-9 place-items-center rounded-full text-[13px] font-bold tabular-nums', i === steps.length - 1 ? 'bg-orange text-navy' : 'bg-navy text-white']}>{i + 1}</span>
					<div>
						<p class="font-semibold">{s.title}</p>
						<p class="mt-0.5 text-[15.5px] leading-snug text-ink-secondary [overflow-wrap:anywhere]">{s.body}</p>
					</div>
				</li>
			))}
		</ol>
		<div class="j-margin self-start bg-canvas-soft p-5">
			<p class="mb-4 text-[15.5px] leading-snug">20 places for the 2026-27 Match, filled in the order applications arrive.</p>
			<Registration slug="match-mentorship" />
		</div>
	</JSection>

	<JSection title="Questions" label="Frequently Asked Questions" id="questions">
		<div class="j-main"><FaqList items={faqs} /></div>
		<aside class="j-margin">
			<h3 class="j-box-title text-[14px]">Related programs</h3>
			<dl class="mt-3 divide-y divide-hairline border-y border-hairline">
				<div class="py-3">
					<dt class="font-semibold">Fellowship Mentorship</dt>
					<dd class="mt-1 text-[14.5px] leading-snug text-ink-secondary">The same twelve months, for fellowship applicants from the U.S. or abroad.</dd>
				</div>
				<div class="py-3">
					<dt class="font-semibold">Green Card Research Mentorship</dt>
					<dd class="mt-1 text-[14.5px] leading-snug text-ink-secondary">For graduates building the research record an EB-1A or National Interest Waiver petition asks for: papers, peer-review roles and the documents to prove them.</dd>
				</div>
			</dl>
			<p class="note mt-3">Ask about either on <a href={contact.matchWhatsapp.href} class="text-navy underline decoration-orange underline-offset-2" rel="noopener">WhatsApp</a>.</p>
		</aside>
	</JSection>

	<NextSteps register="match-mentorship" />

	<ArticleEnd page="e008" refs={refs} />
</Layout>
