---
import { Image } from 'astro:assets';
import ArticleEnd from '../components/journal/ArticleEnd.astro';
import ArticleHead from '../components/journal/ArticleHead.astro';
import Caption from '../components/journal/Caption.astro';
import Expand from '../components/journal/Expand.astro';
import JSection from '../components/journal/JSection.astro';
import NextSteps from '../components/journal/NextSteps.astro';
import Layout from '../layouts/Layout.astro';
import { fellows, leaders, mentors } from '../data/people';
import { contact } from '../data/site';
import { photo } from '../lib/photos';

const analysts = mentors.filter((m) => m.role.includes('Analyst'));
const groupMentors = mentors.filter((m) => !m.role.includes('Analyst'));

const sections = [
	{ id: 'faculty', label: 'Faculty' },
	{ id: 'analysts', label: 'Research Analysts' },
	{ id: 'mentors', label: 'Mentors' },
	{ id: 'fellows', label: 'Where Students Went' },
	{ id: 'join', label: 'Join Us' },
];

const summary = [
	{ a: 'Four physician-scientists at U.S. hospitals lead RC, teach its courses and supervise its projects. Between them they have more than 900 publications.' },
	{ a: 'Four research analysts, specialists in statistics, check the analysis. Eight mentors, most of them former RC students, guide each project group to publication.' },
	{ a: 'More than 20 students have gone on to research jobs at U.S. hospitals. Two of them now teach on the faculty.' },
];
---

<Layout accent="blue" runningHead="Editorial Board" title="Mentors" description="The physician-scientists who lead RC, the research analysts who guide the statistics, the mentors who guide each project group, and the students now in U.S. research jobs.">
	<ArticleHead type="Editorial Board" page="e010" title="The Faculty, Analysts and Mentors Who Will Supervise Your Research" summary={summary} columns sections={sections}>
		<p slot="byline" class="j-affil mt-4 text-[13.5px]">The people who will teach you, check your work and write your letters.</p>
	</ArticleHead>

	<JSection title="The Faculty" label="Senior Editors" id="faculty">
		<ul class="j-span grid gap-x-10 gap-y-12 md:grid-cols-2">
			{leaders.map((p) => (
				<li class="grid gap-5 sm:grid-cols-[9rem_1fr]">
					<Image src={photo(p.photo)} alt={`Portrait of ${p.name}`} widths={[288, 432]} sizes="144px" class="aspect-[4/5] w-full max-w-[9rem] object-cover object-top" />
					<div>
						<p class="text-[13px] font-semibold text-label">{p.role}</p>
						<h3 class="mt-0.5 text-[1.5rem] leading-tight font-light tracking-[-0.015em]">{p.name}</h3>
						<p class="mt-1 text-[14px] leading-snug text-ink-muted">{p.title}, {p.place}</p>
						<p class="mt-3 text-[16px] leading-relaxed text-ink-secondary">{p.bio}</p>
						<p class="mt-3 text-[13.5px] font-medium tabular-nums">{p.publications} publications</p>
					</div>
				</li>
			))}
		</ul>
	</JSection>

	<JSection title="Research Analysts" label="Statistical Editors" id="analysts" newPage>
		<div class="j-main">
			<p class="j-prose">
				Research analysts are senior mentors who specialize in statistics. They help mentors and project groups analyze
				their data correctly, in databases such as the National Inpatient Sample and the Nationwide Readmissions Database,
				and give statistical guidance.
			</p>
			<ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-4">
				{analysts.map((m) => (
					<li>
						<Image src={photo(m.photo)} alt={`Portrait of ${m.name}`} widths={[200, 400]} sizes="(min-width: 640px) 9rem, 45vw" class="aspect-[4/5] w-full object-cover object-top" />
						<p class="mt-2 text-[14px] leading-snug font-semibold">{m.name}</p>
						<p class="mt-0.5 text-[12px] leading-snug text-ink-muted">{m.role}, {m.place}</p>
						<p class="mt-1 text-[12px] font-semibold text-navy tabular-nums">{m.publications} papers</p>
					</li>
				))}
			</ul>
		</div>
	</JSection>

	<JSection title="Mentors" label="Associate Editors" id="mentors" newPage>
		<div class="j-main">
			<p class="j-prose">
				Mentors are experienced researchers, most of them former RC students. Each guides a project group to publication,
				reviewing its work from the first draft to submission.
			</p>
			<ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-4">
				{groupMentors.map((m) => (
					<li>
						<Image src={photo(m.photo)} alt={`Portrait of ${m.name}`} widths={[200, 400]} sizes="(min-width: 640px) 9rem, 45vw" class="aspect-[4/5] w-full object-cover object-top" />
						<p class="mt-2 text-[14px] leading-snug font-semibold">{m.name}</p>
						<p class="mt-0.5 text-[12px] leading-snug text-ink-muted">{m.role}, {m.place}</p>
						<p class="mt-1 text-[12px] font-semibold text-navy tabular-nums">{m.publications} papers</p>
					</li>
				))}
			</ul>
		</div>
	</JSection>

	<JSection title="Where Students Went Next" label="Alumni" id="fellows" newPage>
		<div class="j-main j-prose">
			<p>More than 20 of our students have gone on to research jobs at U.S. hospitals, a common step before applying for residency. Table 1 lists 12 of them, including two who now teach on our faculty.</p>
		</div>
		<figure class="j-span j-rows">
			<Caption label="Table 1" title="RC students and faculty who have held U.S. research fellowships." class="j-caption-top" />
			<div class="overflow-x-auto">
				<table class="j-table sm:min-w-[36rem]">
					<thead><tr><th scope="col">Fellow</th><th scope="col" class="hidden sm:table-cell">Medical school</th><th scope="col">U.S. institution</th></tr></thead>
					<tbody>
						{fellows.map((f, i) => (
							<tr class:list={[i >= 5 && 'more']}>
								<th scope="row" class="font-medium">
									<span class="flex items-center gap-3">
										<Image src={photo(f.photo)} alt="" width={30} height={30} class="size-7.5 shrink-0 rounded-full object-cover" />
										<span>
											{f.name}
											<span class="block text-[12px] font-normal text-ink-muted sm:hidden">{f.school}</span>
										</span>
									</span>
								</th>
								<td class="hidden sm:table-cell">{f.school}</td>
								<td>{f.place}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<p class="j-tablenote">Selected from RC's fellowship announcements.</p>
			<Expand label={`Show all ${fellows.length} fellows`} class="mt-3" />
		</figure>
	</JSection>

	<JSection title="Join Us as a Mentor or Ambassador" label="Call for Papers" id="join">
		<div class="j-main">
			<h3 class="j-subhead">Ambassadors</h3>
			<p class="j-prose mt-2">
				Ambassadors start an RC chapter at their medical school and tell classmates about the courses. In return they get
				free or discounted courses, places on research projects, letters from U.S. faculty when their work earns one, and
				contacts among physicians in the U.S. and Canada for electives and career advice.
			</p>
			<p class="mt-4"><a href={`mailto:${contact.email}?subject=Ambassador%20Application`} class="btn-primary btn-sm">Apply to be an ambassador</a></p>
			<p class="note mt-2">Send your CV, your medical school and your year of graduation.</p>
		</div>
		<aside class="j-margin self-start bg-canvas-soft p-5">
			<h3 class="j-subhead">Mentors</h3>
			<p class="mt-2 text-[16px] leading-snug text-ink-secondary">
				If you have taken RC courses and published about ten full papers, you can apply to run a project group.
			</p>
			<p class="mt-4"><a href={`mailto:${contact.email}?subject=Mentor%20Application`} class="btn-secondary btn-sm">Apply to mentor</a></p>
		</aside>
	</JSection>

	<NextSteps />

	<ArticleEnd page="e010" />
</Layout>
