---
import ActionPanel from '../../components/journal/ActionPanel.astro';
import ArticleEnd from '../../components/journal/ArticleEnd.astro';
import ArticleHead from '../../components/journal/ArticleHead.astro';
import Caption from '../../components/journal/Caption.astro';
import JSection from '../../components/journal/JSection.astro';
import NextSteps from '../../components/journal/NextSteps.astro';
import Registration from '../../components/journal/Registration.astro';
import CourseArt from '../../components/site/CourseArt.astro';
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../lib/paths';
import { courses, method } from '../../data/courses';
import { contact, testimonials } from '../../data/site';

const fact = (c: (typeof courses)[number], label: string) => c.facts.find((f) => f.label === label)?.value;

const sections = [
	{ id: 'choosing', label: 'Which Course Fits Your Question' },
	{ id: 'how', label: 'How a Course Runs' },
	{ id: 'voices', label: 'What Students Say' },
];

const summary = [
	{ q: 'Where do I start?', a: 'With Level 1, if you have never done research. It teaches study design, writing and statistics, and every other course assumes you know them.' },
	{ q: 'What comes next?', a: 'The course whose question matches yours (Table 1). Each one ends with a place in a small project group, led by a mentor, working toward a paper.' },
	{ q: 'Which are open now?', a: 'The padlock beside each course shows whether registration is open. Classes are announced about a month ahead.' },
];

// Three of the course testimonials, the shortest and most specific. The rest are on Student Results.
const voices = [testimonials[0], testimonials[2], testimonials[3]];
---

<Layout accent="teal" runningHead="Choosing a Research Course" title="Courses" description="Five live research courses on Zoom: Level 1, Meta-Analysis, CDC WONDER, the National Inpatient Sample and the Nationwide Readmissions Database. Which to take first, and which are open now.">
	<ArticleHead
		type="State of the Art"
		page="e002"
		title="Choosing Your First Research Course: A Beginner's Guide to Five Courses"
		summary={summary}
		sections={sections}
	>
		<p slot="byline" class="j-affil mt-4 text-[13.5px]">M. Shahzeb Khan, MD, MS; Kaneez Fatima, MD; M. Shariq Usman, MD; Tariq Jamal Siddiqi, MD</p>
		<ActionPanel slot="aside" title="Registration" secondary={{ label: 'Ask which course fits', href: contact.whatsapp.href }} note="Classes are announced on WhatsApp and Instagram.">
			<ul class="-mt-1 mb-2 divide-y divide-hairline">
				{courses.map((c) => (
					<li class="py-2.5">
						<a href={withBase(`/courses/${c.slug}`)} class="text-[15px] font-semibold text-navy underline decoration-orange/40 underline-offset-4 hover:decoration-orange">{c.name}</a>
						<Registration slug={c.slug} variant="status" class="mt-0.5" />
					</li>
				))}
			</ul>
		</ActionPanel>
	</ArticleHead>

	<JSection title="Which Course Fits Your Question" label="Review" id="choosing">
		<figure class="j-span">
			<Caption label="Table 1" title="The five RC courses, by the question each one answers." class="j-caption-top" />
			<!-- On a phone, each course is one entry rather than a table that scrolls sideways. -->
			<ul class="divide-y divide-[#d7d5d1] border-y border-[#d7d5d1] md:hidden">
				{courses.map((c) => (
					<li class="py-3.5">
						<a href={withBase(`/courses/${c.slug}`)} class="group flex items-center gap-2.5">
							<span class:list={['block h-7 w-10 shrink-0 p-0.5', c.tint, c.ink]}><CourseArt art={c.art} /></span>
							<span class="font-semibold text-navy underline decoration-orange/50 decoration-2 underline-offset-4 group-hover:decoration-orange">{c.name}</span>
						</a>
						<p class="mt-2 text-[15px] leading-snug">{c.question}</p>
						<p class="mt-1 text-[13.5px] text-ink-muted">{fact(c, 'Length')} · Before you join: {c.prerequisite}</p>
						<Registration slug={c.slug} variant="status" class="mt-2" />
					</li>
				))}
			</ul>
			<div class="hidden overflow-x-auto md:block">
				<table class="j-table min-w-[58rem]">
					<thead><tr><th scope="col">Course</th><th scope="col">The question it answers</th><th scope="col">Length</th><th scope="col">Before you join</th><th scope="col">Registration</th></tr></thead>
					<tbody>
						{courses.map((c) => (
							<tr class="align-top">
								<th scope="row" class="font-semibold">
									<a href={withBase(`/courses/${c.slug}`)} class="group flex items-center gap-2.5">
										<span class:list={['block h-7 w-10 shrink-0 p-0.5', c.tint, c.ink]}><CourseArt art={c.art} /></span>
										<span class="text-navy underline decoration-orange/50 decoration-2 underline-offset-4 group-hover:decoration-orange">{c.name}</span>
									</a>
								</th>
								<td class="text-[14.5px]">{c.question}</td>
								<td>{fact(c, 'Length')}</td>
								<td>{c.prerequisite}</td>
								<td><Registration slug={c.slug} variant="status" /></td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<p class="j-tablenote">Select a course for what it teaches and how to register. CDC WONDER indicates the CDC's free database of U.S. death records.</p>
		</figure>
	</JSection>

	<JSection title="How a Course Runs" label="Methods" id="how" newPage>
		<div class="j-main j-prose">
			<p>
				Each method course has two parts. First, the class: two or three days, live on Zoom, with the software running on
				your own laptop. Then, when the class ends, you join a project group whose mentor has published the same kind of
				paper. You run the analysis and write the draft, and the group submits the paper to a journal (Figure 1).
			</p>
			<p>
				Level 1 is different. It teaches enough to start a small study on your own, such as a letter to the editor or a
				case report, and has no project group attached.
			</p>
		</div>
		<figure class="j-margin">
			<ol class="j-plate relative space-y-4">
				<span class="absolute top-8 bottom-8 left-[2.1rem] w-px bg-navy/20 sm:left-[2.6rem]" aria-hidden="true"></span>
				{method.map((step, i) => (
					<li class="relative grid grid-cols-[2.25rem_1fr] items-start gap-3">
						<span class:list={['relative z-10 grid size-9 place-items-center rounded-full text-[13px] font-bold tabular-nums ring-4 ring-[#fbfaf7]', i === 0 ? 'bg-navy text-white' : i === method.length - 1 ? 'bg-orange text-navy' : 'bg-white text-navy shadow-[inset_0_0_0_1.5px_#02264d]']}>{i + 1}</span>
						<div>
							<p class="text-[15px] font-semibold text-ink">{step.title}</p>
							<p class="text-[14px] leading-snug text-ink-secondary">{step.body}</p>
						</div>
					</li>
				))}
			</ol>
			<Caption label="Figure 1" title="How a method course runs, from the live class to a submitted paper.">Step 1 is the live class. Steps 2 to 4 happen in the project group after it.</Caption>
		</figure>
	</JSection>

	<JSection title="What Students Say" label="Testimonials" id="voices">
		<ul class="j-span grid gap-x-10 gap-y-8 md:grid-cols-3">
			{voices.map((t) => (
				<li class="flex flex-col">
					<blockquote class="j-quote">"{t.quote}"</blockquote>
					<p class="mt-auto pt-3 text-[13px]"><span class="font-semibold">{t.name}</span><span class="text-ink-muted">, {t.role}</span></p>
				</li>
			))}
		</ul>
		<p class="j-span text-[15px] text-ink-secondary"><a href={withBase('/results#words')} class="link">Read every student's words</a></p>
	</JSection>

	<NextSteps />

	<ArticleEnd page="e002" />
</Layout>
