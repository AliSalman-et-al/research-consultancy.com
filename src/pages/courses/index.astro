---
import Abbreviations from '../../components/journal/Abbreviations.astro';
import ActionPanel from '../../components/journal/ActionPanel.astro';
import ArticleEnd from '../../components/journal/ArticleEnd.astro';
import ArticleHead from '../../components/journal/ArticleHead.astro';
import Caption from '../../components/journal/Caption.astro';
import Cite from '../../components/journal/Cite.astro';
import JSection from '../../components/journal/JSection.astro';
import NextSteps from '../../components/journal/NextSteps.astro';
import CourseArt from '../../components/site/CourseArt.astro';
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../lib/paths';
import { pick } from '../../data/abbreviations';
import { courses, method } from '../../data/courses';
import { contact, enrol, testimonials } from '../../data/site';

const fact = (c: (typeof courses)[number], label: string) => c.facts.find((f) => f.label === label)?.value;

const sections = [
	{ id: 'introduction', label: 'Introduction' },
	{ id: 'choosing', label: 'Choosing a method' },
	{ id: 'how', label: 'How a course runs' },
	{ id: 'voices', label: "Students' words" },
];

const abstract = [
	{
		label: 'Abstract',
		text: 'RC teaches five live courses. Level 1 comes first for anyone who has not done research. After it, the question you want to answer decides the method: pooled published trials call for a meta-analysis, U.S. death trends for CDC WONDER, hospital outcomes and costs for the National Inpatient Sample, and readmissions for the Nationwide Readmissions Database. Every method course ends with a place in a mentored project group. This review compares the five courses and explains how a method course runs.',
	},
];

const refs = [{ text: 'Research Consultancy. RC Level 1, a two-day research workshop. 2026.', href: enrol.level1 }];
---

<Layout accent="teal" runningHead="Choosing a Research Course" title="Courses" description="Five live research courses on Zoom: Level 1, Meta-Analysis, CDC WONDER, the National Inpatient Sample and the Nationwide Readmissions Database. How to choose between them.">
	<ArticleHead
		type="State of the Art"
		page="e002"
		title="Choosing a First Research Method: A Guide to Five Courses for Medical Students"
		abstract={abstract}
		keywords={courses.map((c) => ({ label: c.name, href: `/courses/${c.slug}` }))}
		sections={sections}
	>
		<p slot="byline" class="j-affil mt-4 text-[13.5px]">M. Shahzeb Khan, MD, MS; Kaneez Fatima, MD; M. Shariq Usman, MD; Tariq Jamal Siddiqi, MD</p>
		<ActionPanel
			slot="aside"
			title="Start here"
			lead={{ label: 'Level 1, the first course', value: '$35' }}
			facts={[
				{ label: 'Length', value: '2 days, 6 hours each' },
				{ label: 'Before you join', value: 'Nothing' },
			]}
			primary={{ label: 'See Level 1 and enroll', href: withBase('/courses/level-1') }}
			secondary={{ label: 'Ask which course fits', href: contact.whatsapp.href }}
		/>
	</ArticleHead>

	<JSection title="Introduction" id="introduction" hideTitle>
		<div class="j-main j-prose">
			<p class="drop-cap">
				If you have never done research, take Level 1 first. It teaches study design, writing and statistics, and every
				other course assumes you know them.<Cite n={1} />
			</p>
			<p>
				After Level 1, let the question choose the course. To know whether a treatment works across all the trials already
				published, you need a meta-analysis. To know how deaths from a disease have changed in the United States, you need
				CDC WONDER. Questions about hospital stays, outcomes and costs need the National Inpatient Sample, and questions
				about who comes back to hospital need the Nationwide Readmissions Database.
			</p>
			<p>
				This review compares the five courses by the question each answers, their format and what each requires (Table 1),
				and describes how a method course runs from the first class to a submitted paper (Figure 1).
			</p>
		</div>
		<Abbreviations class="j-margin self-start" items={pick('CDC WONDER', 'NIS', 'NRD', 'PRISMA')} />
	</JSection>

	<JSection title="Choosing a Method" id="choosing" newPage>
		<figure class="j-span">
			<Caption label="Table 1" title="Characteristics of the five RC courses." class="j-caption-top" />
			<div class="overflow-x-auto">
				<table class="j-table min-w-[58rem]">
					<thead><tr><th scope="col">Course</th><th scope="col">The question it answers</th><th scope="col">Length</th><th scope="col">Software</th><th scope="col">Before you join</th><th scope="col">Fee</th></tr></thead>
					<tbody>
						{courses.map((c) => (
							<tr class="align-top">
								<th scope="row" class="font-semibold">
									<a href={withBase(`/courses/${c.slug}`)} class="group flex items-center gap-2.5">
										<span class:list={['block h-7 w-10 shrink-0 p-0.5', c.tint, c.ink]}><CourseArt art={c.art} /></span>
										<span class="text-navy underline decoration-orange/50 decoration-2 underline-offset-4 group-hover:decoration-orange">{c.name}</span>
									</a>
								</th>
								<td class="text-[14.5px]">{c.question}</td>
								<td>{fact(c, 'Length')}</td>
								<td>{fact(c, 'Software')}</td>
								<td>{c.prerequisite}</td>
								<td class="font-semibold text-navy">{c.fee}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<p class="j-tablenote">Select a course for its curriculum and enrollment. Class dates are announced on WhatsApp and Instagram. CDC WONDER indicates CDC Wide-ranging Online Data for Epidemiologic Research.</p>
		</figure>
	</JSection>

	<JSection title="How a Method Course Runs" id="how">
		<div class="j-main j-prose">
			<p>
				Each method course has two parts. The first is the class: two or three days, six hours a day, live on Zoom, with
				the software running on your own laptop. The second begins when the class ends. You join a project group whose
				mentor has published the same kind of paper. You run the analysis, write the draft and revise it until the group
				submits the paper to a journal and the abstract to a conference (Figure 1).
			</p>
			<p>
				Level 1 is different. It teaches enough to start a small study on your own, such as a letter to the editor or a
				case report, and has no project group attached.
			</p>
		</div>
		<figure class="j-margin">
			<ol class="j-plate relative space-y-4">
				<span class="absolute top-8 bottom-8 left-[2.1rem] w-px bg-navy/20 sm:left-[2.6rem]" aria-hidden="true"></span>
				{method.map((step, i) => (
					<li class="relative grid grid-cols-[2.25rem_1fr] items-start gap-3">
						<span class:list={['relative z-10 grid size-9 place-items-center rounded-full text-[13px] font-bold tabular-nums ring-4 ring-[#fbfaf7]', i === 0 ? 'bg-navy text-white' : i === method.length - 1 ? 'bg-orange text-navy' : 'bg-white text-navy shadow-[inset_0_0_0_1.5px_#02264d]']}>{i + 1}</span>
						<div>
							<p class="text-[15px] font-semibold text-ink">{step.title}</p>
							<p class="text-[14px] leading-snug text-ink-secondary">{step.body}</p>
						</div>
					</li>
				))}
			</ol>
			<Caption label="Figure 1" title="Sequence of a method course, from the live class to submission.">Step 1 is the live class. Steps 2 to 4 take place in the project group after the class ends.</Caption>
		</figure>
	</JSection>

	<JSection title="What Students Say" id="voices" newPage>
		<ul class="j-span grid gap-x-10 gap-y-8 md:grid-cols-2 lg:grid-cols-3">
			{testimonials.map((t) => (
				<li class="flex flex-col">
					<blockquote class="j-quote">"{t.quote}"</blockquote>
					<p class="mt-auto pt-3 text-[13px]"><span class="font-semibold">{t.name}</span><span class="text-ink-muted">, {t.role}</span></p>
				</li>
			))}
		</ul>
		<div class="j-main j-prose">
			<h3 class="j-subhead">Conclusions</h3>
			<p>Start with Level 1. Then choose the course whose question matches yours, and plan to stay for the project that follows it.</p>
		</div>
	</JSection>

	<NextSteps focus="publish" />

	<ArticleEnd page="e002" refs={refs} />
</Layout>
