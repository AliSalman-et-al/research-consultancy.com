---
// A course page, set as a "Design and Rationale" paper, in the order a student decides: what the
// course is and who can join (the summary), what it teaches, what you can do afterwards, and what
// happens when the class ends. Registration sits beside the summary and closes the page.
import MethodFigure from '../../components/figures/MethodFigure.astro';
import ActionPanel from '../../components/journal/ActionPanel.astro';
import ArticleEnd from '../../components/journal/ArticleEnd.astro';
import ArticleHead from '../../components/journal/ArticleHead.astro';
import Expand from '../../components/journal/Expand.astro';
import JSection from '../../components/journal/JSection.astro';
import NextSteps from '../../components/journal/NextSteps.astro';
import Registration from '../../components/journal/Registration.astro';
import CourseArt from '../../components/site/CourseArt.astro';
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../lib/paths';
import { courses, type Course } from '../../data/courses';
import { contact } from '../../data/site';

export function getStaticPaths() {
	return courses.map((course, i) => ({ params: { slug: course.slug }, props: { course, page: `e00${i + 3}` } }));
}

interface Props {
	course: Course;
	page: string;
}

const { course, page } = Astro.props;
const others = courses.filter((c) => c.slug !== course.slug);
const refs = course.example ? [{ text: course.example.text, href: course.example.href }] : [];
const fact = (label: string) => course.facts.find((f) => f.label === label)?.value;
const isStart = course.stage === 'Start';
const openToAll = isStart || course.prerequisite.startsWith('None');
const software = (fact('Software') ?? '').replace(/, ([^,]+)$/, ' and $1');
const topics = course.curriculum.reduce((n, b) => n + b.items.length, 0);

const summary = [
	{ q: 'What is it?', a: course.summary },
	{
		q: 'Who can join?',
		a: isStart
			? 'Anyone: medical students in any year, graduates and doctors. You need a laptop and two free days, and no research experience.'
			: openToAll
				? `Anyone. Level 1 helps, because it covers the statistics this course builds on. You need a laptop that can run ${software}.`
				: `Students who have taken Level 1${course.prerequisite.includes('NIS') ? ', ideally the National Inpatient Sample course too' : ''}. You need a laptop that can run ${software}.`,
	},
	{ q: 'What happens after?', a: course.afterClass },
];

const sections = [
	{ id: 'curriculum', label: 'What You Will Learn' },
	{ id: 'outcomes', label: 'What You Will Be Able to Do' },
	{ id: 'follow-up', label: 'After the Class' },
];
---

<Layout accent={course.accent} runningHead={course.name} title={course.name} description={course.summary} register={course.slug}>
	<ArticleHead type="Design and Rationale" page={page} title={course.paperTitle} summary={summary} sections={sections}>
		<p slot="byline" class="j-affil mt-4 flex items-center gap-2.5 text-[13.5px]">
			<span class:list={['block h-7 w-10 shrink-0 p-0.5', course.tint, course.ink]}><CourseArt art={course.art} /></span>
			{isStart ? 'Step 1 of the RC pathway. Take it before any other course.' : 'Step 2 of the RC pathway. Take Level 1 first.'}
		</p>
		<ActionPanel
			slot="aside"
			title="Registration"
			facts={[...course.facts, { label: 'Before you join', value: course.prerequisite }]}
			secondary={{ label: 'Ask a question on WhatsApp', href: contact.whatsapp.href }}
			note="Classes are announced on WhatsApp and Instagram about a month ahead."
		>
			<Registration slug={course.slug} />
		</ActionPanel>
	</ArticleHead>

	<JSection title="What You Will Learn" label="Curriculum" id="curriculum">
		<div class="j-span">
			<p class="max-w-[41rem] text-[1.0625rem] leading-relaxed text-ink-secondary">
				{course.curriculum.length > 1 ? `${course.curriculum.length} days, live on Zoom:` : 'Live on Zoom. The class covers:'}
				{' '}{course.curriculum.length > 1 ? course.curriculum.map((b) => b.title.replace(/^Day \d\.\s*/, '').toLowerCase()).join(', then ') : course.curriculum[0].items.map((i) => i.title.charAt(0).toLowerCase() + i.title.slice(1)).join('; ')}.
			</p>
			{course.curriculum.length > 1 && (
				<Expand label={`Show the day-by-day curriculum (${topics} topics)`} class="mt-4">
					<div class:list={['grid gap-10', course.curriculum.length === 2 && 'md:grid-cols-2', course.curriculum.length >= 3 && 'md:grid-cols-3']}>
						{course.curriculum.map((block) => (
							<div>
								<h3 class="j-subhead border-b-2 border-navy pb-2">{block.title}</h3>
								<ul class="divide-y divide-hairline">
									{block.items.map((item) => (
										<li class="py-3">
											<p class="font-medium">{item.title}</p>
											{item.body && <p class="mt-1 text-[14.5px] leading-relaxed text-ink-muted">{item.body}</p>}
										</li>
									))}
								</ul>
							</div>
						))}
					</div>
				</Expand>
			)}
		</div>
	</JSection>

	<JSection title="What You Will Be Able to Do" label="Outcomes" id="outcomes" newPage>
		<div class="j-main">
			<ol class="space-y-3">
				{course.outcomes.map((o, i) => (
					<li class="grid grid-cols-[1.75rem_1fr] text-[1.0625rem] leading-snug">
						<span class="text-[14px] font-semibold text-label tabular-nums">{i + 1}.</span>
						{o}
					</li>
				))}
			</ol>
		</div>
		<MethodFigure class="j-margin" art={course.art} />
	</JSection>

	<JSection title="After the Class" label="Follow-up" id="follow-up">
		<div class="j-main j-prose">
			{course.example && <p>{course.example.text}<sup><a class="cite" href="#ref-1" data-ref="1">1</a></sup></p>}
			<p>Mentors guide the project groups, and research analysts check the statistics. <a href={withBase('/mentors')}>Meet them</a>.</p>
		</div>
		<aside class="j-margin">
			<h3 class="j-box-title text-[14px]">Other courses</h3>
			<ul class="mt-3 divide-y divide-hairline border-y border-hairline">
				{others.map((c) => (
					<li>
						<a href={withBase(`/courses/${c.slug}`)} class="group flex items-center gap-3 py-2.5">
							<span class:list={['block h-8 w-11 shrink-0 p-0.5', c.tint, c.ink]}><CourseArt art={c.art} /></span>
							<span class="min-w-0 flex-1">
								<span class="block text-[14.5px] font-semibold text-navy underline decoration-orange/40 underline-offset-4 group-hover:decoration-orange">{c.name}</span>
								<span class="block text-[12.5px] text-ink-muted">{c.tagline}</span>
							</span>
							<Registration slug={c.slug} variant="badge" />
						</a>
					</li>
				))}
			</ul>
		</aside>
	</JSection>

	<NextSteps register={course.slug} />

	<ArticleEnd page={page} refs={refs} />
</Layout>
