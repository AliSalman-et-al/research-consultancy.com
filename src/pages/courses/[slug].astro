---
// A course page, set as an AHA "Design and Rationale" paper: who can enroll (eligibility),
// what is taught (intervention), what you will be able to do (outcomes), what happens after
// (follow-up), and how to enroll.
import MethodFigure from '../../components/figures/MethodFigure.astro';
import Abbreviations from '../../components/journal/Abbreviations.astro';
import ActionPanel from '../../components/journal/ActionPanel.astro';
import ArticleEnd from '../../components/journal/ArticleEnd.astro';
import ArticleHead from '../../components/journal/ArticleHead.astro';
import JSection from '../../components/journal/JSection.astro';
import NextSteps from '../../components/journal/NextSteps.astro';
import CourseArt from '../../components/site/CourseArt.astro';
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../lib/paths';
import { pick } from '../../data/abbreviations';
import { courses, type Course } from '../../data/courses';
import { contact } from '../../data/site';

export function getStaticPaths() {
	return courses.map((course, i) => ({ params: { slug: course.slug }, props: { course, page: `e00${i + 3}` } }));
}

interface Props {
	course: Course;
	page: string;
}

const { course, page } = Astro.props;
const others = courses.filter((c) => c.slug !== course.slug);
const refs = course.example ? [{ text: course.example.text, href: course.example.href }] : [];
const fact = (label: string) => course.facts.find((f) => f.label === label)?.value;
const isStart = course.stage === 'Start';
const lower = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);
const openToAll = isStart || course.prerequisite.startsWith('None');
const who = isStart
	? 'Anyone can take Level 1: medical students in any year, graduates and practicing doctors. You need no research experience and no statistics.'
	: openToAll
		? 'Anyone can take this course. Level 1 helps, because it covers the statistics this course builds on, but it is not required.'
		: `This course is for students who have taken Level 1${course.prerequisite.includes('NIS') ? '. The National Inpatient Sample course helps, because the two databases work the same way' : ''}.`;

const abstract = [
	{ label: 'Design', text: course.summary },
	{ label: 'Outcomes', text: `By the end you will be able to ${course.outcomes.slice(0, 3).map(lower).join('; ')}.` },
	{
		label: 'Enrollment',
		text: `${openToAll ? 'Open to anyone; no research experience needed.' : 'Open to students who have taken Level 1.'} Fee: ${course.fee}. Taught live on Zoom.`,
	},
];

const sections = [
	{ id: 'eligibility', label: 'Eligibility' },
	{ id: 'curriculum', label: 'Curriculum' },
	{ id: 'outcomes', label: 'Outcomes' },
	{ id: 'follow-up', label: 'Follow-up' },
];
---

<Layout accent={course.accent} runningHead={`${course.name}: Design and Rationale`} title={course.name} description={course.summary} cta={{ label: course.enrolLabel, href: course.enrolHref }}>
	<ArticleHead type="Design and Rationale" page={page} title={course.paperTitle} abstract={abstract} sections={sections}>
		<p slot="byline" class="j-affil mt-4 flex items-center gap-2.5 text-[13.5px]">
			<span class:list={['block h-7 w-10 shrink-0 p-0.5', course.tint, course.ink]}><CourseArt art={course.art} /></span>
			{isStart ? 'Step 1 of the RC pathway. Take it before any other course.' : 'Step 2 of the RC pathway. Take Level 1 first.'}
		</p>
		<ActionPanel
			slot="aside"
			title="Enrollment"
			lead={{ label: 'Fee', value: course.fee }}
			facts={[...course.facts, { label: 'Before you join', value: course.prerequisite }]}
			primary={{ label: course.enrolLabel, href: course.enrolHref }}
			secondary={course.enrolHref !== contact.whatsapp.href ? { label: 'Ask a question on WhatsApp', href: contact.whatsapp.href } : undefined}
			note="Class dates go out on WhatsApp and Instagram."
		/>
	</ArticleHead>

	<JSection title="Eligibility" id="eligibility">
		<div class="j-main j-prose">
			<p class="drop-cap">{who}</p>
			<p>
				{isStart
					? 'You need a laptop and two free days. The course teaches everything else.'
					: `You need a laptop that can run ${fact('Software')}. The class covers setting it up. You do not need to have published before.`}
			</p>
		</div>
		<Abbreviations class="j-margin self-start" items={pick(...course.abbreviations)} />
	</JSection>

	<JSection title="Curriculum" id="curriculum" newPage>
		<div class:list={['j-span grid gap-10', course.curriculum.length === 2 && 'md:grid-cols-2', course.curriculum.length >= 3 && 'md:grid-cols-3']}>
			{course.curriculum.map((block) => (
				<div>
					<h3 class="j-subhead border-b-2 border-navy pb-2">{block.title}</h3>
					<ul class:list={['divide-y divide-hairline', course.curriculum.length === 1 && 'sm:columns-2 sm:gap-10 sm:divide-y-0']}>
						{block.items.map((item) => (
							<li class="break-inside-avoid py-3">
								<p class="font-medium">{item.title}</p>
								{item.body && <p class="mt-1 text-[14.5px] leading-relaxed text-ink-muted">{item.body}</p>}
							</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</JSection>

	<JSection title="Outcomes" id="outcomes" newPage>
		<div class="j-main">
			<h3 class="j-subhead">Primary Outcome</h3>
			<p class="j-prose mt-2">{course.outcomes[0]}.</p>
			<h3 class="j-subhead mt-6">Secondary Outcomes</h3>
			<ol class="mt-3 space-y-2.5">
				{course.outcomes.slice(1).map((o, i) => (
					<li class="grid grid-cols-[1.75rem_1fr] text-[1.0625rem] leading-snug">
						<span class="text-[14px] font-semibold text-label tabular-nums">{i + 1}.</span>
						{o}
					</li>
				))}
			</ol>
		</div>
		<MethodFigure class="j-margin" art={course.art} />
	</JSection>

	<JSection title="Follow-up" id="follow-up">
		<div class="j-main j-prose">
			<p>{course.afterClass}</p>
			{course.example && (
				<p>{course.example.text}<sup><a class="cite" href="#ref-1" data-ref="1">1</a></sup></p>
			)}
			<p>Near-peer mentors and research analysts run the project groups. <a href={withBase('/mentors')}>Meet them</a>.</p>
		</div>
		<aside class="j-margin">
			<h3 class="j-box-title text-[14px]">Other courses</h3>
			<ul class="mt-3 divide-y divide-hairline border-y border-hairline">
				{others.map((c) => (
					<li>
						<a href={withBase(`/courses/${c.slug}`)} class="group flex items-center gap-3 py-2.5">
							<span class:list={['block h-8 w-11 shrink-0 p-0.5', c.tint, c.ink]}><CourseArt art={c.art} /></span>
							<span>
								<span class="block text-[14.5px] font-semibold text-navy underline decoration-orange/40 underline-offset-4 group-hover:decoration-orange">{c.name}</span>
								<span class="block text-[12.5px] text-ink-muted">{c.tagline}</span>
							</span>
						</a>
					</li>
				))}
			</ul>
		</aside>
	</JSection>

	<NextSteps focus={isStart ? 'start' : 'publish'} />

	<ArticleEnd page={page} refs={refs} />
</Layout>
