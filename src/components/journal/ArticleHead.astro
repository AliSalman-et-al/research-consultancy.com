---
// First page of the article. The order follows Circulation (journal name, article type with a
// rule, Title Case title, byline). In place of an abstract, the page opens with a Plain Language
// Summary, as many journals now print one: three short questions a newcomer actually has, in a
// tinted panel. The right-hand panel carries the page's action; on a phone it follows the summary,
// so a reader knows what this is before they see a price.
import { withBase } from '../../lib/paths';
import Contents from './Contents.astro';

interface Props {
	type: string;
	title: string;
	/** This page's number in the volume, as in "Ann Res Consult. 2026;10:e001". */
	page: string;
	/** Plain Language Summary: a question and its one-sentence answer, or a bare point. */
	summary?: { q?: string; a: string }[];
	/** A row at the foot of the summary that sends one kind of reader to their own page. */
	fork?: { lead: string; label: string; href: string };
	/** Set the summary's questions side by side, as the homepage does. */
	columns?: boolean;
	sections?: { id: string; label: string }[];
}

const { type, title, page, summary, fork, columns = false, sections } = Astro.props;
const hasAside = Astro.slots.has('aside');
const asked = summary?.some((s) => s.q);
// Titles take a paper's shape, "Name: what it is". The name is set a weight heavier, so a reader
// who has never seen a paper finds the subject first.
const colon = title.indexOf(':');
const lead = colon > 0 ? title.slice(0, colon + 1) : title;
const rest = colon > 0 ? title.slice(colon + 1) : '';
---

<header class="relative">
	<span class="j-band lg:hidden" aria-hidden="true"></span>
	<span class="j-tab hidden lg:block" aria-hidden="true">{type}</span>
	<div class="pad pt-6 pb-8 md:pt-8">
		<div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
			<a href={withBase('/')} class="flex items-center gap-2.5" aria-label="Annals of Research Consultancy: Research Consultancy home">
				<img src={withBase('/rc-mark.png')} alt="" width="30" height="30" class="size-7.5 rounded-[4px]" />
				<span class="j-journal">Annals of Research Consultancy</span>
			</a>
			<p class="text-right text-[12px] leading-snug text-ink-muted">
				<i>Ann Res Consult</i> (2026) · Volume 10<br class="hidden sm:inline" /><span class="sm:hidden"> · </span>{page}
			</p>
		</div>

		<div class:list={['grid grid-cols-[minmax(0,1fr)] gap-x-14 gap-y-8 pt-8 md:pt-10 [&>*]:min-w-0', hasAside && 'lg:grid-cols-[minmax(0,1fr)_22rem]']}>
			<div>
				<p class="j-kind">{type}</p>
				<h1 class:list={['j-title mt-4', hasAside ? 'max-w-[24ch]' : 'max-w-[26ch]']}>
					<span class="j-title-lead">{lead}</span>{rest && <span class="j-title-rest">{rest}</span>}
				</h1>
				<slot name="byline" />
			</div>

			{summary && (
				<section aria-labelledby="pls-title" class="j-pls lg:col-start-1">
					<h2 id="pls-title" class="px-5 pt-4 text-[12px] font-bold tracking-[0.08em] text-navy uppercase sm:px-6">Plain Language Summary</h2>
					<div class:list={['px-5 pb-1 sm:px-6', columns && 'md:grid md:grid-cols-3 md:gap-8 md:pb-4']}>
						{summary.map((s) => (
							<div class:list={[
								'border-b border-dotted border-[#b9b3a9] py-3.5 last:border-0',
								columns ? 'md:border-b-0 md:py-3' : asked && 'sm:grid sm:grid-cols-[10rem_1fr] sm:gap-5',
							]}>
								{s.q && <p class:list={['j-pls-q mb-1 sm:mb-0', columns && 'md:mb-1.5 md:text-[1.0625rem]']}>{s.q}</p>}
								<p class="j-pls-a">{s.a}</p>
							</div>
						))}
					</div>
					{fork && (
						<a href={withBase(fork.href)} class="group flex items-center justify-between gap-4 border-t border-[#d9d4cb] bg-white/70 px-5 py-3.5 transition-colors hover:bg-white sm:px-6">
							<span class="text-[15px] leading-snug"><span class="text-ink-secondary">{fork.lead}</span> <span class="font-semibold text-navy underline decoration-orange/60 underline-offset-[3px] group-hover:decoration-orange">{fork.label}</span></span>
							<svg viewBox="0 0 16 16" class="size-4 shrink-0 text-orange transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
						</a>
					)}
				</section>
			)}

			{Astro.slots.has('action') && <div class="lg:col-start-1"><slot name="action" /></div>}

			{hasAside && <div class="lg:col-start-2 lg:row-span-3 lg:row-start-1 lg:pt-12"><slot name="aside" /></div>}
		</div>

		{Astro.slots.has('illustration') && <div class="mt-8"><slot name="illustration" /></div>}
	</div>
	<div class="pad"><div class="h-px bg-[#bdb9b3]"></div></div>
</header>
{sections && <Contents sections={sections} />}
