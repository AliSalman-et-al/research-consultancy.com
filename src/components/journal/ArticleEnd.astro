---
// Back matter, as AHA journals close an article: Article Information (dates, correspondence,
// disclosures, supplemental material), then references with links back to the text, then the
// running foot with the page's citation.
import { contact } from '../../data/site';
import { withBase } from '../../lib/paths';

interface Props {
	/** Page number in the volume, as in "Ann Res Consult. 2026;10:e001". */
	page: string;
	refs?: { text: string; href?: string }[];
	/** Point readers to the Supplemental Material (the Results page). */
	supplement?: boolean;
}

const { page, refs = [], supplement = false } = Astro.props;
const citation = `Ann Res Consult. 2026;10:${page}`;
---

<section aria-label="Article information and references">
	<div class="pad j-grid pt-8 pb-8 md:pt-10">
		<div class="j-main">
			<h2 class="j-paperhead">Article Information</h2>
			<dl class="mt-4 space-y-2.5 text-[14px] leading-relaxed text-ink-secondary">
				<div>
					<dt class="inline font-semibold text-ink">Correspondence </dt>
					<dd class="inline">
						Research Consultancy. WhatsApp <a href={contact.whatsapp.href} class="link font-normal" rel="noopener">{contact.whatsapp.label}</a>; email{' '}
						<a href={`mailto:${contact.email}`} class="link font-normal [overflow-wrap:anywhere]">{contact.email}</a>.
					</dd>
				</div>
				{supplement && (
					<div><dt class="inline font-semibold text-ink">Supplemental Material </dt><dd class="inline">The papers, careers, meeting photographs and awards behind these numbers are in the <a href={withBase('/results')} class="link font-normal">Supplemental Material</a>.</dd></div>
				)}
				<div>
					<dt class="inline font-semibold text-ink">Disclosures </dt>
					<dd class="inline">RC teaches and mentors. It does not conduct studies for students or guarantee publication or a match. Authorship depends on each student's contribution.</dd>
				</div>
			</dl>
		</div>
		{refs.length > 0 && (
			<div class="j-margin">
				<h2 class="j-paperhead">References</h2>
				<ol class="mt-4 space-y-2.5">
					{refs.map((r, i) => (
						<li id={`ref-${i + 1}`} class="grid scroll-mt-32 grid-cols-[1.5rem_1fr] target:bg-orange/10">
							<span class="text-[13px] text-ink-muted tabular-nums">{i + 1}.</span>
							<span class="text-[13.5px] leading-snug text-ink-secondary">
								{r.text}{' '}
								{r.href && <a href={r.href} class="[overflow-wrap:anywhere] text-navy underline decoration-orange/60 underline-offset-2" rel="noopener">{new URL(r.href).hostname.replace(/^www\./, '')}</a>}
								<a href={`#cite-${i + 1}`} class="ml-1 text-[11.5px] text-ink-faint no-underline hover:text-navy" aria-label={`Back to reference ${i + 1} in the text`}>Back to text</a>
							</span>
						</li>
					))}
				</ol>
			</div>
		)}
	</div>
	<div class="pad">
		<div class="masthead border-t border-ink/60 py-3 text-ink-muted">
			<span><i>{citation}</i> · research-consultancy.org</span>
			<span>September 2026 · {page}</span>
		</div>
	</div>
</section>
