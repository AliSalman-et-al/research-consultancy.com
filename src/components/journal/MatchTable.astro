---
// Match results, one row per student, grouped by Match year. Each student's own words sit in
// their row, so a quote is always read against the program it led to.
import { Image } from 'astro:assets';
import type { Matched } from '../../data/people';
import { photo } from '../../lib/photos';
import Caption from './Caption.astro';
import Expand from './Expand.astro';

interface Props {
	label: string;
	title: string;
	groups: { name: string; rows: Matched[] }[];
	footnote: string;
	/** Show this many rows, then "Show all". */
	shown?: number;
}

const { label, title, groups, footnote, shown } = Astro.props;
const total = groups.reduce((n, g) => n + g.rows.length, 0);
const offsets = groups.map((_, i) => groups.slice(0, i).reduce((n, g) => n + g.rows.length, 0));
const initials = (n: string) => n.split(' ').map((w) => w[0]).slice(0, 2).join('');
---

<figure class:list={[shown && 'j-rows']}>
	<Caption label={label} title={title} class="j-caption-top" />
	<!-- On a phone, each student is one entry: a four-column table would scroll sideways. -->
	<div class="border-t border-[#d7d5d1] md:hidden">
		{groups.map((g, gi) => (
			<ul class:list={[shown && offsets[gi] >= shown && 'more']} aria-label={g.name}>
				<li class="bg-[#f3f2f0] px-3 py-2 text-[13px] font-semibold">{g.name} <span class="font-normal text-ink-muted">({g.rows.length})</span></li>
				{g.rows.map((m, ri) => (
					<li class:list={['flex gap-3 border-b border-[#d7d5d1] px-1 py-3', shown && offsets[gi] + ri >= shown && 'more']}>
						{m.photo ? (
							<Image src={photo(m.photo)} alt="" width={40} height={40} class="size-10 shrink-0 rounded-full object-cover" />
						) : (
							<span class="grid size-10 shrink-0 place-items-center rounded-full bg-navy/10 text-[11px] font-semibold text-navy" aria-hidden="true">{initials(m.name)}</span>
						)}
						<div class="min-w-0 text-[14px] leading-snug">
							<p class="font-semibold">{m.name}</p>
							<p class="text-ink-secondary">{m.specialty}, {m.program}</p>
							{m.quote && <p class="mt-1.5 text-[14px] text-ink-secondary italic">"{m.quote}"</p>}
						</div>
					</li>
				))}
			</ul>
		))}
	</div>
	<div class="hidden overflow-x-auto md:block">
		<table class="j-table min-w-[56rem]">
			<thead>
				<tr>
					<th scope="col" class="w-[24%]">Student</th>
					<th scope="col" class="w-[13%]">Specialty</th>
					<th scope="col" class="w-[23%]">Program</th>
					<th scope="col">In their words</th>
				</tr>
			</thead>
			{groups.map((g, gi) => (
				<tbody class:list={[shown && offsets[gi] >= shown && 'more']}>
					<tr class="group"><th scope="colgroup" colspan="4">{g.name} <span class="font-normal text-ink-muted">({g.rows.length})</span></th></tr>
					{g.rows.map((m, ri) => (
						<tr class:list={['align-top', shown && offsets[gi] + ri >= shown && 'more']}>
							<th scope="row" class="font-medium">
								<span class="flex items-center gap-3">
									{m.photo ? (
										<Image src={photo(m.photo)} alt="" width={34} height={34} class="size-8.5 shrink-0 rounded-full object-cover" />
									) : (
										<span class="grid size-8.5 shrink-0 place-items-center rounded-full bg-navy/10 text-[10.5px] font-semibold text-navy" aria-hidden="true">{initials(m.name)}</span>
									)}
									<span>
										{m.name}
										{m.school && <span class="block text-[12px] font-normal text-ink-muted">{m.school}</span>}
									</span>
								</span>
							</th>
							<td>{m.specialty}</td>
							<td>{m.program}</td>
							<td class="text-[14.5px] leading-snug text-ink-secondary italic">{m.quote && `"${m.quote}"`}</td>
						</tr>
					))}
				</tbody>
			))}
		</table>
	</div>
	<p class="j-tablenote">{footnote}</p>
	{shown && total > shown && <Expand label={`Show all ${total} students`} class="mt-3" />}
</figure>
