---
// The article's last line: one action that fits this page, and a way to ask first. On a course
// page, that action is the course's own registration.
import { contact } from '../../data/site';
import { withBase } from '../../lib/paths';
import Registration from './Registration.astro';

interface Props {
	/** Which next step this page leads to. */
	focus?: 'start' | 'publish' | 'match';
	/** A course's slug: end on its registration instead. */
	register?: string;
}

const { focus = 'start', register } = Astro.props;

const steps = {
	start: { lead: 'Start with Level 1.', detail: 'Two live days on Zoom. No research experience needed.', action: 'See Level 1', href: '/courses/level-1' },
	publish: { lead: 'Ready for a first study?', detail: 'Pick a method course; a mentored project group follows it.', action: 'Choose a course', href: '/courses' },
	match: { lead: 'Applying for residency in the next two years?', detail: 'Match Mentorship takes 20 students a year.', action: 'See how to apply', href: '/match-mentorship#apply' },
} as const;
const s = steps[focus];
---

<section id="next-steps" aria-label="Next step" class="no-print scroll-mt-28">
	<div class="pad pb-10 md:pb-12">
		<div class="flex flex-col gap-4 border-y-[1.5px] border-navy py-5 sm:flex-row sm:items-center sm:justify-between sm:gap-8">
			{register ? (
				<Registration slug={register} variant="row" class="reg-strip min-w-0 flex-1" />
			) : (
				<p class="text-[1.0625rem] leading-snug text-ink-secondary">
					<span class="font-semibold text-navy">{s.lead}</span> {s.detail}
				</p>
			)}
			<div class="flex shrink-0 flex-wrap gap-2">
				{!register && <a href={withBase(s.href)} class="btn-primary">{s.action}</a>}
				<a href={contact.whatsapp.href} class="btn-secondary" rel="noopener">Ask on WhatsApp</a>
			</div>
		</div>
	</div>
</section>
