---
// A journal website's "Expand" control, for reference material a reader scans rather than reads:
// full lists, the day-by-day curriculum, the FAQ. The label says exactly what opens.
interface Props {
	label: string;
	/** Open to start with. */
	open?: boolean;
	class?: string;
}

const { label, open = false, class: className } = Astro.props;
---

<details class:list={['j-expand group', className]} open={open}>
	<summary class="j-expand-summary">
		<svg viewBox="0 0 16 16" class="size-4 shrink-0 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 3.5 4.5 4.5L6 12.5" /></svg>
		<span class="group-open:hidden">{label}</span><span class="hidden group-open:inline">Show less</span>
	</summary>
	<div class="pt-4"><slot /></div>
</details>
