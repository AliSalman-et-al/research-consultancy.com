---
// Figure: what a clinical study is. Panel A traces one real student paper from the question to
// the journal, so research stops being abstract; panel B shows why RC teaches the two designs a
// student outside the United States can start without patients or a hospital.
import Caption from '../journal/Caption.astro';

interface Props {
	label: string;
	class?: string;
}

const { label, class: className } = Astro.props;

const needs = [
	{ design: 'Clinical trial', patients: 'yes', ethics: 'yes', site: 'yes' },
	{ design: 'Chart review', patients: 'yes', ethics: 'yes', site: 'yes' },
	{ design: 'Meta-analysis', patients: 'no', ethics: 'no', site: 'no', rc: true },
	{ design: 'U.S. database study', patients: 'no', ethics: 'exempt', site: 'no', rc: true },
] as const;

const stages = [
	{ stage: 'Question', what: 'After clot removal for a stroke, which patients are back in hospital within 30 days, and why?', color: '#4c9be8' },
	{ stage: 'Data', what: 'Nearly 30,000 admissions in the Nationwide Readmissions Database, a U.S. record of hospital stays.', color: '#1b8a8f' },
	{ stage: 'Analysis', what: 'Readmission rates, then a regression model to find which patient factors predict a return.', color: '#7b4fa0' },
	{ stage: 'Abstract', what: 'A one-page summary, presented at the American Academy of Neurology meeting in 2026.', color: '#c98a12' },
	{ stage: 'Paper', what: 'Reviewed by other doctors, then published in Neurology in 2026.', color: '#f67737', href: 'https://doi.org/10.1212/WNL.0000000000217891' },
];
---

<figure class:list={[className]}>
	<div class="j-plate space-y-5">
		<p class="j-panel-head">A. One study, from question to journal</p>
		<ol class="reveal relative space-y-3.5">
			<span class="absolute top-4 bottom-4 left-[calc(0.625rem-1px)] w-[2px] bg-[#e4e1db]" aria-hidden="true"></span>
			{stages.map((s, i) => (
				<li class="relative grid grid-cols-[1.25rem_1fr] items-start gap-3">
					<span class="pop relative z-10 mt-1 size-5 rounded-full ring-4 ring-[#fbfaf7]" style={`background:${s.color};--i:${i * 6}`} aria-hidden="true"></span>
					<div>
						<p class="font-sans text-[12px] font-bold tracking-[0.04em] uppercase" style={`color:color-mix(in srgb, ${s.color} 70%, black)`}>{s.stage}</p>
						<p class="text-[14.5px] leading-snug text-ink">
							{s.href ? <a href={s.href} class="underline decoration-orange/60 underline-offset-2 hover:decoration-orange" rel="noopener">{s.what}</a> : s.what}
						</p>
					</div>
				</li>
			))}
		</ol>
		<div class="border-t border-[#e4e1db] pt-4">
			<p class="j-panel-head">B. What a first study needs</p>
			<table class="w-full text-[13px]">
				<thead>
					<tr class="text-left text-[12px] text-ink-muted">
						<th scope="col" class="pb-2 font-semibold">First study</th>
						<th scope="col" class="pb-2 text-center font-semibold">Patients</th>
						<th scope="col" class="pb-2 text-center font-semibold">Ethics review</th>
						<th scope="col" class="pb-2 text-center font-semibold">Hospital access</th>
					</tr>
				</thead>
				<tbody>
					{needs.map((n) => (
						<tr class:list={['border-t border-[#e4e1db]', 'rc' in n && 'bg-white']}>
							<th scope="row" class:list={['py-2.5 pl-1 text-left', 'rc' in n ? 'font-semibold text-navy' : 'font-normal text-ink-secondary']}>{n.design}</th>
							{[n.patients, n.ethics, n.site].map((v) => (
								<td class="py-2.5 text-center">
									{v === 'yes' && <svg viewBox="0 0 20 20" class="mx-auto size-5 text-[#b8b3ab]" role="img" aria-label="Needed"><circle cx="10" cy="10" r="7" fill="currentColor" /></svg>}
									{v === 'no' && <svg viewBox="0 0 20 20" class="mx-auto size-5 text-teal" role="img" aria-label="Not needed"><circle cx="10" cy="10" r="7" fill="none" stroke="currentColor" stroke-width="2" /></svg>}
									{v === 'exempt' && <span class="text-[11.5px] font-semibold text-teal">Usually exempt</span>}
								</td>
							))}
						</tr>
					))}
				</tbody>
			</table>
			<p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-[11.5px] text-ink-muted">
				<span class="flex items-center gap-1.5"><span class="size-2.5 rounded-full bg-[#b8b3ab]"></span>Needed</span>
				<span class="flex items-center gap-1.5"><span class="size-2.5 rounded-full ring-2 ring-teal ring-inset"></span>Not needed</span>
			</p>
		</div>
	</div>
	<Caption label={label} title="What a clinical study involves.">
		<b>A</b>, A readmission study led by an RC student, Adeena Jamil, who took Level 1 in the second year of medical school.
		Select the last stage to read the paper. <b>B</b>, RC teaches the 2 designs in the lower rows, which a student can
		start from any country. Ethics requirements vary by country and institution.
	</Caption>
</figure>
