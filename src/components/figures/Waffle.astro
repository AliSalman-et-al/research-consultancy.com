---
// Waffle charts: each panel is 100 squares, one per percent of RC's students.
import Caption from '../journal/Caption.astro';

interface Props {
	label: string;
	title: string;
	panels: { pct: number; name: string; rest: string; color: string }[];
	class?: string;
}

const { label, title, panels, class: className } = Astro.props;
---

<figure class:list={[className]}>
	<div class="j-plate reveal grid gap-6 sm:grid-cols-2">
		{panels.map((p, k) => (
			<div>
				<p class="flex items-baseline gap-2 font-sans">
					<span class="text-[2rem] leading-none font-light tracking-[-0.03em] text-navy tabular-nums">{p.pct}%</span>
					<span class="text-[13px] font-semibold text-ink">{p.name}</span>
				</p>
				<div class="mt-3 grid grid-cols-10 gap-[3px]" role="img" aria-label={`${p.pct} in 100 students: ${p.name}`}>
					{Array.from({ length: 100 }, (_, i) => (
						<span class="pop aspect-square rounded-[2px]" style={`background:${i < p.pct ? p.color : '#e4e1db'};--i:${i + k * 20}`}></span>
					))}
				</div>
				<p class="mt-2 flex items-center gap-3 text-[11.5px] text-ink-muted">
					<span class="flex items-center gap-1.5"><span class="size-2.5 rounded-[2px]" style={`background:${p.color}`}></span>{p.name}</span>
					<span class="flex items-center gap-1.5"><span class="size-2.5 rounded-[2px] bg-[#e4e1db]"></span>{p.rest}</span>
				</p>
			</div>
		))}
	</div>
	<Caption label={label} title={title}><slot /></Caption>
</figure>
