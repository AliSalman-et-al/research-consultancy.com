---
import { contact, nav } from '../../data/site';
import { withBase } from '../../lib/paths';
import Registration from '../journal/Registration.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = base && Astro.url.pathname.startsWith(base)
	? Astro.url.pathname.slice(base.length) || '/'
	: Astro.url.pathname;
const path = currentPath.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);

interface Props {
	cta: { label: string; href: string };
	/** On a course page, register for this course instead. */
	register?: string;
}
const { cta, register } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-hairline bg-canvas/90 backdrop-blur-md">
	<div class="frame pad flex h-16 items-center justify-between gap-5">
		<a href={withBase('/')} class="flex shrink-0 items-center gap-2.5 rounded-md" aria-label="Research Consultancy home">
			<img src={withBase('/rc-mark.png')} alt="" width="36" height="36" class="size-9 rounded-md" />
			<span class="hidden text-[15px] font-semibold tracking-[-0.01em] whitespace-nowrap text-ink md:inline lg:hidden xl:inline">Research Consultancy</span>
		</a>

		<nav aria-label="Primary" class="hidden items-center lg:flex">
			{nav.map((item) => (
				<a
					href={withBase(item.href)}
					aria-current={isActive(item.href) ? 'page' : undefined}
					class:list={[
						'rounded-md px-2 py-1.5 text-[15px] whitespace-nowrap transition-colors hover:bg-canvas-soft hover:text-ink',
						isActive(item.href) ? 'font-semibold text-navy' : 'text-ink-secondary',
					]}
				>
					{item.label}
				</a>
			))}
		</nav>

		<div class="flex shrink-0 items-center gap-2">
			{cta.href !== contact.whatsapp.href && <a href={contact.whatsapp.href} class="hidden items-center gap-1.5 rounded-md px-1.5 py-1.5 text-[15px] whitespace-nowrap text-ink-secondary hover:text-ink xl:inline-flex" rel="noopener">
				<svg viewBox="0 0 24 24" class="size-4 text-green" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.8-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
				WhatsApp
			</a>}
			{register
				? <Registration slug={register} variant="button" class="hidden lg:block" />
				: <a href={cta.href} class="btn-primary btn-sm hidden lg:inline-flex" rel={cta.href.startsWith('http') || cta.href.startsWith('mailto') ? 'noopener' : undefined}>{cta.label}</a>}

			<details class="group relative lg:hidden">
				<summary class="btn-utility cursor-pointer list-none [&::-webkit-details-marker]:hidden" aria-label="Menu">
					<svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
						<path class="group-open:hidden" d="M4 7h16M4 12h16M4 17h16" />
						<path class="hidden group-open:block" d="M6 6l12 12M18 6L6 18" />
					</svg>
				</summary>
				<nav aria-label="Mobile" class="shadow-elevated absolute right-0 mt-2 flex w-64 flex-col rounded-xl border border-hairline bg-canvas p-2">
					<a href={withBase('/')} class="rounded-[5px] px-3 py-2.5 text-[15px] text-ink hover:bg-canvas-soft">Home</a>
					{nav.map((item) => (
						<a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined} class="rounded-[5px] px-3 py-2.5 text-[15px] text-ink hover:bg-canvas-soft aria-[current=page]:font-semibold">{item.label}</a>
					))}
					<a href={contact.whatsapp.href} class="mt-1 rounded-[5px] bg-canvas-soft px-3 py-2.5 text-[15px] font-medium text-ink" rel="noopener">Message us on WhatsApp</a>
				</nav>
			</details>
		</div>
	</div>
</header>
